install_dotfiles() {
    # Font
    red_echo "[*] Installing fonts..."
    retry sudo pacman -S --needed --noconfirm inter-font otf-geist-mono-nerd noto-fonts noto-fonts-cjk noto-fonts-emoji noto-fonts-extra ttf-nerd-fonts-symbols ttf-dejavu
    run_yay nerd-fonts-sf-mono-ligatures ttf-ms-fonts otf-takao ttf-rubik-vf
    run_yay apple-fonts --mflags "--skipinteg"
    blue_echo "[*] Copy fonts ..."
    safe_link "$DOTFILES_DIR/.fonts" "$HOME/.fonts"
    fc-cache -fv
    green_echo "[*] Done."
    sleep 3 && clear

    # Icon theme & Cursor theme
    red_echo "[*] Copy icons ..."
    run_yay whitesur-icon-theme-git
    safe_link "$DOTFILES_DIR/.icons" "$HOME/.icons"
    green_echo "[*] Done."
    sleep 3 && clear

    # Themes
    red_echo "[*] Copy themes ..."
    run_yay adw-gtk-theme matugen-bin qt5-wayland qt6-wayland qt6ct-kde qt5ct-kde kvantum kvantum-qt5 breeze-gtk breeze-icons
    green_echo "[*] Done."
    sleep 3 && clear

    # Config
    red_echo "[*] Copy config ..."
    if ! [ -d "$HOME/.config" ]; then
        mkdir -p "$HOME/.config"
    fi

    safe_link "$DOTFILES_DIR/.config/zsh" "$HOME/.config/zsh"
    if ! grep -q 'source "$HOME/.config/zsh/.zshrc"' "$HOME/.zshrc" 2>/dev/null; then
        printf '%s\n' 'source "$HOME/.config/zsh/.zshrc"' >> "$HOME/.zshrc"
    fi
    # Set default shell to Zsh
    if [ "$SHELL" != "/usr/bin/zsh" ] && [ "$SHELL" != "/bin/zsh" ]; then
        sudo chsh -s /usr/bin/zsh "$USER"
    fi
    safe_link "$DOTFILES_DIR/.config/fontconfig" "$HOME/.config/fontconfig"

    mkdir -p "$HOME/.config/gtk-3.0"
    safe_link "$DOTFILES_DIR/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-3.0/settings.ini"
    safe_link "$DOTFILES_DIR/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-3.0/gtk.css"
    write_gtk_bookmarks

    mkdir -p "$HOME/.config/gtk-4.0"
    safe_link "$DOTFILES_DIR/.config/gtk-4.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"
    safe_link "$DOTFILES_DIR/.config/gtk-4.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"
    safe_link "/usr/share/themes/adw-gtk3/gtk-4.0/assets" "$HOME/.config/gtk-4.0/assets"

    safe_link "$DOTFILES_DIR/.config/matugen" "$HOME/.config/matugen"

    safe_link "$DOTFILES_DIR/.config/qt5ct" "$HOME/.config/qt5ct"
    safe_link "$DOTFILES_DIR/.config/qt6ct" "$HOME/.config/qt6ct"
    safe_link "$DOTFILES_DIR/.config/Kvantum" "$HOME/.config/Kvantum"
    mkdir -p "$HOME/.config/qt5ct/colors"
    mkdir -p "$HOME/.config/qt6ct/colors"

    mkdir -p "$HOME/.config/vesktop/themes"
    green_echo "[*] Done."
    sleep 3 && clear

    # Local
    red_echo "[*] Copy local ..."
    if ! [ -d "$HOME/.local" ]; then
        mkdir -p "$HOME/.local"
    fi
    mkdir -p "$HOME/.local/share/applications"
    mkdir -p "$HOME/.local/share/blackbox/schemes"
    green_echo "[*] Done."
    sleep 3 && clear
    cd ~
}

install_shell_environment() {
    red_echo "[*] Installing Niri Wayland environment ..."
    install_shell_runtime
    run_yay wl-gammarelay-rs swayidle
    run_yay fcitx5 fcitx5-lotus-bin fcitx5-configtool fcitx5-gtk fcitx5-qt
    sudo systemctl enable --now fcitx5-lotus-server@$(whoami).service
    mkdir -p ~/.config/fcitx5/conf
    printf 'Mode=SuperSmooth\n' > ~/.config/fcitx5/conf/lotus.conf
    safe_link "$DOTFILES_DIR/.config/niri" "$HOME/.config/niri"
    clear

    red_echo "[*] Installing Quickshell ..."
    if [ -d "$QUICKSHELL_DIR/.git" ]; then
        git -C "$QUICKSHELL_DIR" pull --ff-only
    elif [ -e "$QUICKSHELL_DIR" ]; then
        red_echo "[!] $QUICKSHELL_DIR exists but is not a Git checkout; refusing to replace it."
        return 1
    else
        git clone https://github.com/sownteedev/dotfiles.git --depth=1 --branch=sownteeshell "$QUICKSHELL_DIR"
    fi
    green_echo "[*] Done."

    sleep 3 && clear

    # GNOME applications
    run_yay evince loupe
    gsettings set org.gnome.desktop.wm.preferences resize-with-right-button true
    gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close'
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
    gsettings set org.gnome.desktop.interface icon-theme WhiteSur
    gsettings set org.gnome.desktop.interface cursor-theme Dark_Cursor

    cd ~
    sleep 3 && clear
}

# Boot and display-manager themes
prompt_theme_selection() {
    local theme_root="$1"
    local theme_label="$2"
    local selection
    local selection_number
    local theme_path
    local index
    local -a theme_names=()

    for theme_path in "$theme_root"/*; do
        [ -d "$theme_path" ] || continue
        theme_names+=("$(basename "$theme_path")")
    done

    if (( ${#theme_names[@]} == 0 )); then
        red_echo "[!] No ${theme_label} themes found in $theme_root."
        return 1
    fi

    red_echo "[*] ${theme_label} themes available:"
    for index in "${!theme_names[@]}"; do
        blue_echo "  $((index + 1))) ${theme_names[index]}"
    done

    while true; do
        if ! read -r -p "[*] Select ${theme_label} theme [1-${#theme_names[@]}]: " selection; then
            red_echo "[!] Theme selection was cancelled."
            return 1
        fi
        if [[ "$selection" =~ ^[0-9]+$ ]]; then
            selection_number=$((10#$selection))
            if (( selection_number >= 1 && selection_number <= ${#theme_names[@]} )); then
                SELECTED_THEME_NAME="${theme_names[selection_number - 1]}"
                green_echo "[*] Selected ${theme_label} theme: $SELECTED_THEME_NAME"
                return 0
            fi
        fi
        red_echo "[!] Enter a number from 1 to ${#theme_names[@]}."
    done
}

select_theme_sddm() {
    local theme_name

    sudo mkdir -p /etc/sddm.conf.d
    prompt_theme_selection "$DOTFILES_DIR/.root/sddm-theme" "SDDM"
    theme_name="$SELECTED_THEME_NAME"
    printf '[Theme]\nCurrent=%s\n' "$theme_name" | sudo tee /etc/sddm.conf.d/20-theme.conf >/dev/null
    sudo systemctl enable sddm
}

select_theme_grub() {
    local grub_defaults="/etc/default/grub"
    local selected_theme
    local theme_name
    local module
    local -a image_modules=()

    prompt_theme_selection "$DOTFILES_DIR/.root/grub/themes" "GRUB"
    theme_name="$SELECTED_THEME_NAME"
    selected_theme="$DOTFILES_DIR/.root/grub/themes/$theme_name"
    find "$selected_theme" -type f -iname '*.png' -print -quit | grep -q . && image_modules+=(png)
    find "$selected_theme" -type f \( -iname '*.jpg' -o -iname '*.jpeg' \) -print -quit | grep -q . && image_modules+=(jpeg)
    find "$selected_theme" -type f -iname '*.tga' -print -quit | grep -q . && image_modules+=(tga)

    for module in "${image_modules[@]}"; do
        if grep -Eq "^GRUB_PRELOAD_MODULES=\"([^\"]*[[:space:]])?${module}([[:space:]][^\"]*)?\"" "$grub_defaults"; then
            continue
        fi
        if grep -q '^GRUB_PRELOAD_MODULES="' "$grub_defaults"; then
            sudo sed -i -E "s/^(GRUB_PRELOAD_MODULES=\"[^\"]*)\"/\\1 ${module}\"/" "$grub_defaults"
        else
            printf 'GRUB_PRELOAD_MODULES="%s"\n' "$module" | sudo tee -a "$grub_defaults" >/dev/null
        fi
    done

    sudo sed -i "s|^#\?GRUB_THEME=.*|GRUB_THEME=/usr/share/grub/themes/${theme_name}/theme.txt|g" "$grub_defaults"
    sudo grub-mkconfig -o /boot/grub/grub.cfg
}

# Application configuration
patch_desktop_entry() {
    local app="$1"
    local flags="$2"
    local target_dir="$3"
    local original="/usr/share/applications/$app"
    local target="$target_dir/$app"

    [ -f "$original" ] || return 0
    cp "$original" "$target"
    if ! grep -q "ozone-platform-hint" "$target"; then
        sed -i '/^Exec=/s/ / '"$flags"' /' "$target"
    fi
}

patch_wayland_flags() {
    local target_dir="$HOME/.local/share/applications"
    local base_flags="--test-type --ozone-platform-hint=wayland --ignore-gpu-blocklist --enable-wayland-ime --disable-gpu-sandbox --password-store=gnome-libsecret"
    local chrome_flags="$base_flags --enable-features=TouchpadOverscrollHistoryNavigation --disable-features=ExtensionManifestV2Unsupported"
    local electron_flags="$base_flags --gtk-version=4"
    local -a electron_apps=(
        code.desktop postman.desktop vesktop.desktop spotify.desktop
        cursor.desktop antigravity-ide.desktop
    )
    local -a chrome_apps=(google-chrome.desktop)
    local app

    mkdir -p "$target_dir"

    for app in "${electron_apps[@]}"; do
        patch_desktop_entry "$app" "$electron_flags" "$target_dir"
    done

    for app in "${chrome_apps[@]}"; do
        patch_desktop_entry "$app" "$chrome_flags" "$target_dir"
    done
}

configure_blackbox() {
    local -ar keys=(
        cursor-shape
        easy-copy-paste
        font
        pretty
        style-preference
        terminal-cell-height
        terminal-padding
        theme-bold-is-bright
        theme-dark
        theme-light
    )
    local -ar values=(
        "1"
        "true"
        "GeistMono Nerd Font 11"
        "true"
        "0"
        "1.25"
        "(uint32 30, uint32 30, uint32 30, uint32 30)"
        "true"
        "Custom"
        "Custom"
    )
    local index

    for ((index = 0; index < ${#keys[@]}; index++)); do
        gsettings set com.raggesilver.BlackBox "${keys[index]}" "${values[index]}"
    done
    green_echo "[*] Blackbox Setting Applied."
}

install_workspace() {
    red_echo "[*] Installing Grub Theme ..."
    sudo mkdir -p /usr/share/grub/themes && sudo cp -a "$DOTFILES_DIR/.root/grub/themes/." /usr/share/grub/themes/
    sudo chmod -x /etc/grub.d/30_uefi-firmware
    sudo sed -i 's/^#GRUB_DISABLE_SUBMENU=y/GRUB_DISABLE_SUBMENU=y/' /etc/default/grub
    select_theme_grub
    sudo sed -i "/^[[:space:]]*echo[[:space:]]*'Loading /d" /boot/grub/grub.cfg
    green_echo "[*] Grub Theme setup done."
    sleep 3 && clear

    red_echo "[*] Installing Display Manager (SDDM)"
    run_yay sddm qt6-svg qt6-base qt6-multimedia qt6-5compat qt6-imageformats qt6-declarative gst-libav gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-plugins-base
    sudo mkdir -p /usr/share/sddm/themes && sudo cp -a "$DOTFILES_DIR/.root/sddm-theme/." /usr/share/sddm/themes/
    select_theme_sddm
    green_echo "[*] Display Manager setup done."
    sleep 3 && clear

    red_echo "[*] Installing TeVim ..."
    run_yay lazygit fzf ripgrep neovim neovide chafa thefuck
    rm -rf "$HOME/.config/nvim"
    git clone https://github.com/sownteedev/TeVim.git --depth 1 "$HOME/.config/nvim"
    safe_link "$DOTFILES_DIR/.config/nvim/lua/custom" "$HOME/.config/nvim/lua/custom"
    green_echo "[*] TeVim setup done."
    sleep 3 && clear

    red_echo "[*] Installing Development Applications..."
    run_yay visual-studio-code-bin jetbrains-toolbox docker docker-compose lazydocker blackbox-terminal
    configure_blackbox
    sudo usermod -aG docker "$USER"
    sudo systemctl enable --now docker.service
    run_yay vmware-keymaps vmware-workstation
    sudo systemctl enable --now vmware-networks.service vmware-usbarbitrator.service
    green_echo "[*] Done."
    sleep 3 && clear

    red_echo "[*] Installing Other Applications..."
    run_yay vesktop-bin telegram-desktop-bin onlyoffice-bin google-chrome sunshine-bin steam

    local sunshine_unit=""
    if [ -f /usr/lib/systemd/user/app-dev.lizardbyte.app.Sunshine.service ]; then
        sunshine_unit="app-dev.lizardbyte.app.Sunshine.service"
    elif [ -f /usr/lib/systemd/user/sunshine.service ]; then
        sunshine_unit="sunshine.service"
    fi

    if [ -n "$sunshine_unit" ]; then
        systemctl --user daemon-reload
        systemctl --user enable --now "$sunshine_unit"
        blue_echo "[*] Sunshine is available at https://localhost:47990"
    else
        red_echo "[!] Sunshine was installed, but its user service was not found."
    fi

    if systemctl list-unit-files avahi-daemon.service >/dev/null 2>&1; then
        sudo systemctl enable --now avahi-daemon.service
    fi

    patch_wayland_flags

    retry sudo pacman -S --needed --noconfirm flatpak
    retry flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    retry flatpak install -y flathub com.usebottles.bottles com.spotify.Client
    flatpak override --user --filesystem=home com.usebottles.bottles
    flatpak override --user --socket=session-bus com.usebottles.bottles
    flatpak override --user --talk-name=org.fcitx.Fcitx5 com.usebottles.bottles
    flatpak override --user --talk-name=org.freedesktop.portal.Fcitx com.usebottles.bottles
    flatpak override --user --env=XMODIFIERS=@im=fcitx com.usebottles.bottles
    flatpak override --user --env=GTK_IM_MODULE=fcitx com.usebottles.bottles
    # --disable-gpu-compositing --disable-smooth-scrolling

    green_echo "[*] Environment setup complete."
    sleep 3 && clear
}

# Command dispatcher
main() {
    local option

    if [ "$#" -ne 1 ]; then
        printf 'Usage: %s {--all|--dots|--env|--shell-deps|--features|--workspace|--sddm|--grub|--waylandflag}\n' "$0" >&2
        return 2
    fi
    option="$1"

    case "$option" in
        --all|--dots|--env|--shell-deps|--features|--workspace|--sddm|--grub|--waylandflag)
            ;;
        *)
            red_echo "[!] Unknown option: $option"
            printf 'Usage: %s {--all|--dots|--env|--shell-deps|--features|--workspace|--sddm|--grub|--waylandflag}\n' "$0" >&2
            return 2
            ;;
    esac

    case "$option:$INSTALLER_DRY_RUN" in
        --waylandflag:*|--shell-deps:1|--features:1)
            ;;
        *)
            start_sudo_keepalive
            ;;
    esac

    case "$option" in
        --all)
            install_dotfiles
            install_shell_environment
            install_shell_features
            install_workspace
            ;;
        --dots)
            install_dotfiles
            ;;
        --env)
            install_shell_environment
            ;;
        --shell-deps)
            install_shell_runtime
            ;;
        --features)
            install_shell_features
            ;;
        --workspace)
            install_workspace
            ;;
        --sddm)
            select_theme_sddm
            ;;
        --grub)
            select_theme_grub
            ;;
        --waylandflag)
            patch_wayland_flags
            ;;
    esac
}

cd "$HOME"
main "$@"

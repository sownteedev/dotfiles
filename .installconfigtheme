install_shell_environment() {
    red_echo "[*] Installing Niri Wayland environment ..."
    install_shell_runtime
    run_yay wl-gammarelay-rs swayidle
    run_yay fcitx5 fcitx5-lotus-bin fcitx5-configtool fcitx5-gtk fcitx5-qt
    sudo systemctl enable --now fcitx5-lotus-server@$(whoami).service
    mkdir -p ~/.config/fcitx5/conf
    printf 'Mode="Uinput (Slow)"\nFixUinputWithAck=True\nAutoNonVnRestore=False\nDoubleSpaceToPeriod=True\nUseLotusIcons=False' > ~/.config/fcitx5/conf/lotus.conf
    safe_link "$DOTFILES_DIR/.config/niri" "$HOME/.config/niri"

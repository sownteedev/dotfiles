#!/usr/bin/env bash
cd ~

DOTFILES_DIR="$HOME/Dotfiles/dotf"
QUICKSHELL_DIR="$HOME/Dotfiles/quickshell"
INSTALLER_DRY_RUN="${INSTALLER_DRY_RUN:-0}"

# Fail fast and safer word splitting
set -euo pipefail
IFS=$'\n\t'
# Color helpers
GREEN='\033[0;32m'
NC='\033[0m'
green_echo() {
    printf "%b\n" "${GREEN}$1${NC}"
}
RED='\033[0;31m'
red_echo() {
    printf "%b\n" "${RED}$1${NC}"
}
BLUE='\033[0;34m'
blue_echo() {
    printf "%b\n" "${BLUE}$1${NC}"
}

# Helper to create/replace symlinks on a fresh installation
safe_link() {
    local src="$1"
    local dst="$2"
    if [ -L "$dst" ] && [ "$(readlink -f -- "$dst")" = "$(readlink -f -- "$src")" ]; then
        return 0
    fi
    if [ -z "$dst" ] || [ "$dst" = "/" ] || [ "$dst" = "$HOME" ]; then
        red_echo "[!] Refusing unsafe symlink destination: ${dst:-<empty>}"
        return 1
    fi
    if [ -e "$dst" ] || [ -L "$dst" ]; then
        rm -rf -- "$dst"
    fi
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
}

run_yay() {
    if [ "$INSTALLER_DRY_RUN" = "1" ]; then
        printf '[dry-run] yay -S --needed --noconfirm'
        printf ' %q' "$@"
        printf '\n'
        return 0
    fi
    yay -S --needed --noconfirm "$@"
}

install_shell_runtime() {
    local -a packages=(
        niri xwayland-satellite quickshell-git qt6-connectivity
        python curl libnotify libcanberra zenity
        pipewire pipewire-pulse wireplumber playerctl cava
        bluez bluez-utils brightnessctl upower power-profiles-daemon
        slurp wl-clipboard hyprpicker gpu-screen-recorder ffmpeg imagemagick
        inotify-tools jq pciutils matugen-bin
    )
    red_echo "[*] Installing required Quickshell runtime packages ..."
    run_yay "${packages[@]}"
}

install_shell_features() {
    local -a packages=(
        tesseract tesseract-data-eng tesseract-data-vie
        mpvpaper linux-wallpaperengine-git
        tailscale cloudflare-warp-bin
        howdy v4l-utils
    )
    red_echo "[*] Installing optional Quickshell features ..."
    run_yay "${packages[@]}"
}

install_face_manager() {
    if [ "$INSTALLER_DRY_RUN" = "1" ]; then
        printf '[dry-run] install howdy-face-manager -> /usr/lib/quickshell/howdy-face-manager\n'
        return 0
    fi
    if ! command -v howdy >/dev/null 2>&1; then
        red_echo "[!] Howdy is not installed; skipping the Settings bridge."
        return 0
    fi
    sudo install -Dm755 "$QUICKSHELL_DIR/scripts/howdy-face-manager.py" /usr/lib/quickshell/howdy-face-manager
}

enable_optional_services() {
    [ "$INSTALLER_DRY_RUN" = "1" ] && return 0
    if systemctl list-unit-files tailscaled.service >/dev/null 2>&1; then
        sudo systemctl enable --now tailscaled.service
    fi
    if systemctl list-unit-files warp-svc.service >/dev/null 2>&1; then
        sudo systemctl enable --now warp-svc.service
        ensure_warp_registration || true
    fi
}

write_gtk_bookmarks() {
    local bookmarks="$HOME/.config/gtk-3.0/bookmarks"
    local directory

    {
        for directory in Documents Downloads Pictures Templates Videos Music Public .local .config .fonts .icons Dotfiles Projects; do
            printf 'file://%s/%s %s\n' "$HOME" "$directory" "$directory"
        done

        if [ -d /mnt/windows ]; then
            printf 'file:///mnt/windows windows\n'
        fi
        if [ -d "/mnt/windows/Users/Nguyen Thanh Son/Downloads" ]; then
            printf 'file:///mnt/windows/Users/Nguyen%%20Thanh%%20Son/Downloads Downloads\n'
        fi

        printf 'admin:///var/lib/tailscale/files files\n'
    } > "$bookmarks"
}

setup_dotfiles() {
    # Font
    red_echo "[*] Installing fonts..."
    sudo pacman -S --needed inter-font otf-geist-mono-nerd noto-fonts noto-fonts-cjk noto-fonts-emoji noto-fonts-extra ttf-nerd-fonts-symbols ttf-dejavu --noconfirm && yay -S --needed nerd-fonts-sf-mono-ligatures apple-fonts ttf-ms-fonts otf-takao ttf-rubik-vf --noconfirm
    blue_echo "[*] Copy fonts ..."
    safe_link "$DOTFILES_DIR/.fonts" "$HOME/.fonts"
    fc-cache -fv
    green_echo "[*] Done."
    sleep 3 && clear

    # Icon theme & Cursor theme
    red_echo "[*] Copy icons ..."
	yay -S --needed whitesur-icon-theme-git --noconfirm
    safe_link "$DOTFILES_DIR/.icons" "$HOME/.icons"
    green_echo "[*] Done."
    sleep 3 && clear

    # Themes
    red_echo "[*] Copy themes ..."
	yay -S adw-gtk-theme matugen-bin qt5-wayland qt6-wayland qt6ct-kde qt5ct-kde breeze-gtk breeze-icons --noconfirm
    green_echo "[*] Done."
    sleep 3 && clear

    # Config
    red_echo "[*] Copy config ..."
    if ! [ -d "$HOME/.config" ]; then
        mkdir -p "$HOME/.config"
    fi

    safe_link "$DOTFILES_DIR/.config/zsh" "$HOME/.config/zsh"
    if ! grep -q 'source "$HOME/.config/zsh/.zshrc"' "$HOME/.zshrc" 2>/dev/null; then
        printf '%s\n' 'source "$HOME/.config/zsh/.zshrc"' >> "$HOME/.zshrc"
    fi
    # Set default shell to Zsh
    if [ "$SHELL" != "/usr/bin/zsh" ] && [ "$SHELL" != "/bin/zsh" ]; then
        sudo chsh -s /usr/bin/zsh "$USER"
    fi
    safe_link "$DOTFILES_DIR/.config/fontconfig" "$HOME/.config/fontconfig"

    mkdir -p "$HOME/.config/gtk-3.0"
    safe_link "$DOTFILES_DIR/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-3.0/settings.ini"
    safe_link "$DOTFILES_DIR/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-3.0/gtk.css"
    write_gtk_bookmarks

    mkdir -p "$HOME/.config/gtk-4.0"
    safe_link "$DOTFILES_DIR/.config/gtk-4.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"
    safe_link "$DOTFILES_DIR/.config/gtk-4.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"
    safe_link "/usr/share/themes/adw-gtk3/gtk-4.0/assets" "$HOME/.config/gtk-4.0/assets"

    safe_link "$DOTFILES_DIR/.config/matugen" "$HOME/.config/matugen"

	safe_link "$DOTFILES_DIR/.config/qt5ct" "$HOME/.config/qt5ct"
	safe_link "$DOTFILES_DIR/.config/qt6ct" "$HOME/.config/qt6ct"
    mkdir -p "$HOME/.config/qt5ct/colors"
    mkdir -p "$HOME/.config/qt6ct/colors"

    mkdir -p "$HOME/.config/vesktop/themes"
    green_echo "[*] Done."
    sleep 3 && clear

    # Local
    red_echo "[*] Copy local ..."
    if ! [ -d "$HOME/.local" ]; then
        mkdir -p "$HOME/.local"
    fi
    mkdir -p "$HOME/.local/share/applications"
    mkdir -p "$HOME/.local/share/blackbox/schemes"
    green_echo "[*] Done."
    sleep 3 && clear
    cd ~
}


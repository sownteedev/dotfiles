    safe_link "$DOTFILES_DIR/.config/niri" "$HOME/.config/niri"
    clear

    # red_echo "[*] Installing Ags/Astal ..."
    # yay -S --needed --noconfirm libastal-meta aylurs-gtk-shell-git libastal-gjs
    # rm -rf "$DOTFILES_DIR/ags"
    # git clone https://github.com/sownteedev/dotfiles.git --depth=1 --branch=ags/astal "$DOTFILES_DIR/ags" || { red_echo "Failed to clone ags branch"; exit 1; }
    # cd "$HOME"
    # mkdir -p installagsv2
    # cp "$DOTFILES_DIR/ags/PKGBUILD" "$HOME/installagsv2/PKGBUILD"
    # cd "$HOME/installagsv2"
    # makepkg -si --noconfirm
    # cd "$HOME"
    # rm -rf installagsv2


select_theme_sddm() {
    sudo mkdir -p /etc/sddm.conf.d
    red_echo "[*] Themes available:"
    for theme_path in "$DOTFILES_DIR/.root/sddm-theme"/*; do
        [ -e "$theme_path" ] || continue
        blue_echo "  - $(basename "$theme_path")"
    done
    while true; do
        read -p "[*] Type theme you want use: " THEME_NAMES
        if [ -d "$DOTFILES_DIR/.root/sddm-theme/$THEME_NAMES" ]; then
            break
        else
            red_echo "[*] Theme not found, please try again."
        fi
    done
    printf '[Theme]\nCurrent=%s\n' "$THEME_NAMES" | sudo tee /etc/sddm.conf.d/20-theme.conf >/dev/null
    sudo systemctl enable sddm
}

select_theme_grub() {
    red_echo "[*] Themes available:"
    for theme_path in "$DOTFILES_DIR/.root/grub/themes"/*; do
        [ -e "$theme_path" ] || continue
        blue_echo "  - $(basename "$theme_path")"
    done
    while true; do
        read -p "[*] Type theme you want use: " THEME_NAMES
        if [ -d "$DOTFILES_DIR/.root/grub/themes/$THEME_NAMES" ]; then
            break
        else
            red_echo "[*] Theme not found, please try again."
        fi
    done
    sudo sed -i "s|^#\?GRUB_THEME=.*|GRUB_THEME=/usr/share/grub/themes/${THEME_NAMES}/theme.txt|g" /etc/default/grub
    sudo grub-mkconfig -o /boot/grub/grub.cfg
}

patch_wayland_flags() {
    local LOCAL_DIR="$HOME/.local/share/applications"
    mkdir -p "$LOCAL_DIR"

	local BASE_FLAGS="--test-type --ozone-platform-hint=wayland --ignore-gpu-blocklist --enable-wayland-ime --disable-gpu-sandbox --password-store=gnome-libsecret"
    local CHROME_FLAGS="$BASE_FLAGS --enable-features=TouchpadOverscrollHistoryNavigation --disable-features=ExtensionManifestV2Unsupported"
    local ELECTRON_FLAGS="$BASE_FLAGS --gtk-version=4"

    local ELECTRON_APPS=("code.desktop" "postman.desktop" "vesktop.desktop" "spotify.desktop" "cursor.desktop" "antigravity-ide.desktop")
    local CHROME_APPS=("google-chrome.desktop")

    inject_flags() {
        local app=$1
        local flags=$2
        local target="$LOCAL_DIR/$app"
        local original="/usr/share/applications/$app"

        if [ -f "$original" ]; then
            cp "$original" "$target"
            if ! grep -q "ozone-platform-hint" "$target"; then
                sed -i '/^Exec=/s/ / '"$flags"' /' "$target"
            fi
        fi
    }

    for app in "${ELECTRON_APPS[@]}"; do
        inject_flags "$app" "$ELECTRON_FLAGS"
    done

    for app in "${CHROME_APPS[@]}"; do
        inject_flags "$app" "$CHROME_FLAGS"
    done
}

ensure_warp_registration() {
    local attempt

    for attempt in {1..15}; do
        if warp-cli registration show >/dev/null 2>&1; then
            green_echo "[*] WARP is already registered."
            return 0
        fi

        if warp-cli registration new >/dev/null 2>&1; then
            green_echo "[*] WARP registration created."
            return 0
        fi

        sleep 1
    done

    red_echo "[!] Unable to verify or create the WARP registration."
    return 1
}

setting_blackbox() {
    readonly -a keys=(
        cursor-shape
        easy-copy-paste
        font
        pretty
        style-preference
        terminal-cell-height
        terminal-padding
        theme-bold-is-bright
        theme-dark
    )
    readonly -a values=(
        "1"
        "true"
        "GeistMono Nerd Font 11"
        "true"
        "0"
        "1.25"
        "(uint32 30, uint32 30, uint32 30, uint32 30)"
        "true"
        "Custom"
    )
    for ((index = 0; index < ${#keys[@]}; index++)); do
        gsettings set com.raggesilver.BlackBox "${keys[index]}" "${values[index]}"
    done
    green_echo "[*] Blackbox Setting Applied."
}

install_workspace() {
    red_echo "[*] Installing Grub Theme ..."
    sudo mkdir -p /usr/share/grub/themes && sudo cp -a "$DOTFILES_DIR/.root/grub/themes/." /usr/share/grub/themes/
	sudo chmod -x /etc/grub.d/30_uefi-firmware
	sudo sed -i 's/^#GRUB_DISABLE_SUBMENU=y/GRUB_DISABLE_SUBMENU=y/' /etc/default/grub
    select_theme_grub
	sudo sed -i "/^[[:space:]]*echo[[:space:]]*'Loading /d" /boot/grub/grub.cfg
    green_echo "[*] Grub Theme setup done."
    sleep 3 && clear

    red_echo "[*] Installing Display Manager (SDDM)"
    yay -S --needed --noconfirm sddm qt6-svg qt6-base qt6-multimedia qt6-5compat qt6-imageformats qt6-declarative gst-libav gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-plugins-base
    sudo mkdir -p /usr/share/sddm/themes && sudo cp -a "$DOTFILES_DIR/.root/sddm-theme/." /usr/share/sddm/themes/
    select_theme_sddm
    green_echo "[*] Display Manager setup done."
    sleep 3 && clear

    red_echo "[*] Installing TeVim ..."
    yay -S --needed --noconfirm lazygit fzf ripgrep neovim neovide chafa thefuck
    rm -rf "$HOME/.config/nvim"
    git clone https://github.com/sownteedev/TeVim.git --depth 1 "$HOME/.config/nvim"
    safe_link "$DOTFILES_DIR/.config/nvim/lua/custom" "$HOME/.config/nvim/lua/custom"
    green_echo "[*] TeVim setup done."
    sleep 3 && clear

    red_echo "[*] Installing Development Applications..."
    yay -S --needed --noconfirm visual-studio-code-bin jetbrains-toolbox docker docker-compose lazydocker postman-bin blackbox-terminal
    setting_blackbox
	sudo usermod -aG docker $USER
    sudo systemctl enable --now docker.service
    yay -S --needed --noconfirm vmware-keymaps vmware-workstation
    sudo systemctl enable --now vmware-networks.service vmware-usbarbitrator.service
    green_echo "[*] Done."
    sleep 3 && clear

    red_echo "[*] Installing Other Applications..."
    yay -S --needed --noconfirm vesktop-bin telegram-desktop-bin spotify onlyoffice-bin google-chrome antigravity-ide rustdesk-bin sunshine-bin steam
    if systemctl --user list-unit-files sunshine.service >/dev/null 2>&1; then
        systemctl --user enable --now sunshine.service
    fi

	patch_wayland_flags

	sudo pacman -S --needed flatpak --noconfirm
	flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
	flatpak install -y flathub com.usebottles.bottles
	flatpak override --user --filesystem=home com.usebottles.bottles
	flatpak override --user --socket=session-bus com.usebottles.bottles
	flatpak override --user --talk-name=org.fcitx.Fcitx5 com.usebottles.bottles
	flatpak override --user --talk-name=org.freedesktop.portal.Fcitx com.usebottles.bottles
	flatpak override --user --env=XMODIFIERS=@im=fcitx com.usebottles.bottles
	flatpak override --user --env=GTK_IM_MODULE=fcitx com.usebottles.bottles
	# --disable-gpu-compositing --disable-smooth-scrolling

    green_echo "[*] Environment setup complete."
    sleep 3 && clear

}


while [[ $# -gt 0 ]]; do
    case "$1" in
        --workspace)
			install_workspace
            exit 0
            ;;
		--env)
			setup_env
			exit 0
            ;;
        --shell-deps)
            install_shell_runtime
            exit 0
            ;;
        --features)
            install_shell_features
            install_face_manager
            enable_optional_services
            exit 0
            ;;
        --sddm)
			select_theme_sddm
			exit 0
            ;;
        --grub)
			select_theme_grub
			exit 0
            ;;
        --dots)
			setup_dotfiles
			exit 0
            ;;
        --waylandflag)
			patch_wayland_flags
			exit 0
			;;
		--all)
			setup_dotfiles
			setup_env
			install_shell_features
			install_face_manager
			enable_optional_services
			install_workspace
			exit 0
    esac
done

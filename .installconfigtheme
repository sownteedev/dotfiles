        "0"
        "1.25"
        "(uint32 30, uint32 30, uint32 30, uint32 30)"
        "true"
        "Custom"
        "Custom"
    )
    local index

    for ((index = 0; index < ${#keys[@]}; index++)); do
        gsettings set com.raggesilver.BlackBox "${keys[index]}" "${values[index]}"
    done
    green_echo "[*] Blackbox Setting Applied."
}

install_workspace() {
    red_echo "[*] Installing Grub Theme ..."
    sudo mkdir -p /usr/share/grub/themes && sudo cp -a "$DOTFILES_DIR/.root/grub/themes/." /usr/share/grub/themes/
    sudo chmod -x /etc/grub.d/30_uefi-firmware
    sudo sed -i 's/^#GRUB_DISABLE_SUBMENU=y/GRUB_DISABLE_SUBMENU=y/' /etc/default/grub
    select_theme_grub
    sudo sed -i "/^[[:space:]]*echo[[:space:]]*'Loading /d" /boot/grub/grub.cfg
    green_echo "[*] Grub Theme setup done."
    sleep 3 && clear

    red_echo "[*] Installing Display Manager (greetd + Quickshell)"
    install_greetd
    green_echo "[*] Display Manager setup done."
    sleep 3 && clear

    red_echo "[*] Installing TeVim ..."
    run_yay lazygit fzf ripgrep neovim neovide chafa thefuck
    rm -rf "$HOME/.config/nvim"
    git clone https://github.com/sownteedev/TeVim.git --depth 1 "$HOME/.config/nvim"
    safe_link "$DOTFILES_DIR/.config/nvim/lua/custom" "$HOME/.config/nvim/lua/custom"
    green_echo "[*] TeVim setup done."
    sleep 3 && clear

    red_echo "[*] Installing Development Applications..."
    run_yay visual-studio-code-bin jetbrains-toolbox docker docker-compose lazydocker blackbox-terminal
    configure_blackbox
    sudo usermod -aG docker "$USER"
    sudo systemctl enable --now docker.service
    run_yay vmware-keymaps vmware-workstation
    sudo systemctl enable --now vmware-networks.service vmware-usbarbitrator.service
    green_echo "[*] Done."
    sleep 3 && clear

    red_echo "[*] Installing Other Applications..."
    run_yay vesktop-bin telegram-desktop-bin onlyoffice-bin brave-bin sunshine-bin

    local sunshine_unit=""
    if [ -f /usr/lib/systemd/user/app-dev.lizardbyte.app.Sunshine.service ]; then
        sunshine_unit="app-dev.lizardbyte.app.Sunshine.service"
    elif [ -f /usr/lib/systemd/user/sunshine.service ]; then
        sunshine_unit="sunshine.service"
    fi

    if [ -n "$sunshine_unit" ]; then
        systemctl --user daemon-reload
        systemctl --user enable --now "$sunshine_unit"
        blue_echo "[*] Sunshine is available at https://localhost:47990"
    else
        red_echo "[!] Sunshine was installed, but its user service was not found."
    fi

    if systemctl list-unit-files avahi-daemon.service >/dev/null 2>&1; then
        sudo systemctl enable --now avahi-daemon.service
    fi

    patch_wayland_flags

    retry sudo pacman -S --needed --noconfirm flatpak
    retry flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    retry flatpak install -y flathub com.usebottles.bottles com.spotify.Client
    flatpak override --user --filesystem=home com.usebottles.bottles
    flatpak override --user --socket=session-bus com.usebottles.bottles
    flatpak override --user --talk-name=org.fcitx.Fcitx5 com.usebottles.bottles
    flatpak override --user --talk-name=org.freedesktop.portal.Fcitx com.usebottles.bottles
    flatpak override --user --env=XMODIFIERS=@im=fcitx com.usebottles.bottles
    flatpak override --user --env=GTK_IM_MODULE=fcitx com.usebottles.bottles
    # --disable-gpu-compositing --disable-smooth-scrolling

    green_echo "[*] Environment setup complete."
    sleep 3 && clear
}

# Command dispatcher
main() {
    local option

    if [ "$#" -ne 1 ]; then
        printf 'Usage: %s {--all|--dots|--env|--shell-deps|--features|--workspace|--greetd|--grub|--waylandflag}\n' "$0" >&2
        return 2
    fi
    option="$1"

    case "$option" in
        --all|--dots|--env|--shell-deps|--features|--workspace|--greetd|--grub|--waylandflag)
            ;;
        *)
            red_echo "[!] Unknown option: $option"
            printf 'Usage: %s {--all|--dots|--env|--shell-deps|--features|--workspace|--greetd|--grub|--waylandflag}\n' "$0" >&2
            return 2
            ;;
    esac

    case "$option:$INSTALLER_DRY_RUN" in
        --waylandflag:*|--shell-deps:1|--features:1|--greetd:1)
            ;;
        *)
            start_sudo_keepalive
            ;;
    esac

    case "$option" in
        --all)
            install_dotfiles
            install_shell_environment
            install_shell_features
            install_workspace
            ;;
        --dots)
            install_dotfiles
            ;;
        --env)
            install_shell_environment
            ;;
        --shell-deps)
            install_shell_runtime
            ;;
        --features)
            install_shell_features
            ;;
        --workspace)
            install_workspace
            ;;
        --greetd)
            install_greetd
            ;;
        --grub)
            select_theme_grub
            ;;
        --waylandflag)
            patch_wayland_flags
            ;;
    esac
}

cd "$HOME"
main "$@"

#!/usr/bin/env bash
cd ~

DOTFILES_DIR="$HOME/Dotfiles/dotf"

setup_dotfiles() {
    # Font
    echo "[*] Installing fonts..."
    sudo pacman -S noto-fonts noto-fonts-cjk noto-fonts-emoji --noconfirm && yay -S apple-fonts ttf-rubik-vf ttf-ms-win11-auto ttf-ms-win11-auto-korean ttf-ms-win11-auto-zh_cn --noconfirm
    echo "[*] Copy fonts ..."
    ln -s $DOTFILES_DIR/.fonts ~/.fonts
    fc-cache -fv
    echo "[*] Done."
    sleep 3 && clear

    # Icon theme & Cursor theme
    echo "[*] Copy icons ..."
    ln -s $DOTFILES_DIR/.icons ~/.icons
    echo "[*] Done."
    sleep 3 && clear

    # Themes
    echo "[*] Copy themes ..."
    ln -s $DOTFILES_DIR/.themes ~/.themes
    echo "[*] Done."
    sleep 3 && clear

    # Config
    echo "[*] Copy config ..."
    if ! [ -d $HOME/.config ]; then
        mkdir -p $HOME/.config
    fi
    ln -s $DOTFILES_DIR/.config/zsh ~/.config/zsh
    ln -s $DOTFILES_DIR/.config/fontconfig ~/.config/fontconfig
    ln -s $DOTFILES_DIR/.config/gtk-3.0 ~/.config/gtk-3.0
    ln -s $DOTFILES_DIR/.config/gtk-4.0 ~/.config/gtk-4.0
    echo "[*] Done."
    sleep 3 && clear

    # Local
    echo "[*] Copy local ..."
    if ! [ -d $HOME/.local ]; then
        mkdir -p $HOME/.local
    fi
    mkdir -p ~/.local/share/applications
    ln -s $DOTFILES_DIR/.local/bin ~/.local/bin
	ln -s $DOTFILES_DIR/.local/share/blackbox ~/.local/share
    echo "[*] Done."
    sleep 3 && clear
    cd ~
}

setup_env() {
    read -p "[*] Do you want to use my WM configs? ( 1 for X / 2 for W ): " choice
    if [ "$choice" = "1" ]; then
        sudo pacman -S --noconfirm xorg xorg-xinit redshift maim xsettingsd arandr xss-lock gpick xclip xsel
        yay -S --noconfirm picom-git
        clear

        echo "[*] Enable touchpad for laptop and set time to sleep ..."
        yay -S xf86-input-libinput xf86-input-synaptics libinput-gestures xdotool wmctrl --noconfirm
        sudo rm -rf /etc/X11/xorg.conf.d
        sudo ln -s $DOTFILES_DIR/.root/xorg.conf.d /etc/X11/xorg.conf.d
		ln -s $DOTFILES_DIR/.config/libinput-gestures.conf ~/.config/libinput-gestures.conf
        sudo gpasswd -a $USER input
        libinput-gestures-setup stop desktop autostart start
        sleep 3 && clear
		
		echo "[*] Copy .Xresources ..."
		rm -f ~/.Xresources && ln -s $DOTFILES_DIR/.Xresources ~/.Xresources
		echo "[*] Done."
		sleep 3 && clear

        echo "[*] Override .xinitrc ..."
        rm -f ~/.xinitrc && ln -s $DOTFILES_DIR/.xinitrc ~/.xinitrc
        echo "[*] Done"
        sleep 3 && clear

		echo "[*] Install ibus"
		yay -S ibus ibus-bamboo --noconfirm
		env DCONF_PROFILE=ibus dconf write /desktop/ibus/general/preload-engines "['xkb:us::eng', 'Bamboo']" && gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('ibus', 'Bamboo')]"

		echo "[*] Installing AwesomeWM ..."
		yay -S awesome-luajit-git lua-pam-git --noconfirm
        rm -rf ~/.config/awesome
		clear
        read -p "[*] What version AwesomeWM? ( 1 for default / 2 for mAWMcos ): " choice
        if [ "$choice" = "1" ]; then
            echo "[*] Installing Default ..."
            git clone https://github.com/sownteedev/dotfiles.git --depth=1 --branch=awesome $DOTFILES_DIR/awesome
            ln -s $DOTFILES_DIR/awesome ~/.config/awesome
            echo "[*] Done."
        else
            echo "[*] Installing mAWMcos ..."
            git clone https://github.com/sownteedev/dotfiles.git --depth=1 --branch=mAWMcos $DOTFILES_DIR/mAWMcos
            ln -s $DOTFILES_DIR/mAWMcos ~/.config/awesome
            echo "[*] Done."
        fi
    elif [ "$choice" = "2" ]; then
        echo "[*] Installing Niri ..."
        yay -S niri xwayland-satellite --noconfirm
		yay -S slurp gpu-screen-recorder wl-clipboard hyprpicker gammastep swayidle --noconfirm
        yay -S fcitx5 fcitx5-bamboo fcitx5-configtool fcitx5-gtk --noconfirm
        rm -rf ~/.config/niri
        ln -s $DOTFILES_DIR/.config/niri ~/.config/niri
		echo "[*] Installing Ags/Astal ..."
		yay -S libastal-meta aylurs-gtk-shell-git libastal-gjs --noconfirm
		git clone https://github.com/sownteedev/dotfiles.git --depth=1 --branch=ags/astal $DOTFILES_DIR/ags
		cp $DOTFILES_DIR/ags/PKGBUILD ~/Downloads/PKGBUILD
		cd ~/Downloads && makepkg -si --noconfirm
        echo "[*] Done."
    fi
	sleep 3 && clear
	# echo "[*] Installing Gnome ..."
	# yay -S gnome --noconfirm
	# yay -S gnome-tweaks extension-manager --noconfirm
	gsettings set org.gnome.desktop.wm.preferences resize-with-right-button true
	gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close'
	gsettings set org.gnome.desktop.interface gtk-theme phocus
	gsettings set org.gnome.desktop.interface icon-theme WhiteSur
	gsettings set org.gnome.desktop.interface cursor-theme Dark_Cursor

    cd ~
    sleep 3 && clear
}

select_theme_sddm() {
    THEMES=$(ls "$DOTFILES_DIR/.root/sddm-theme")
    echo "[*] Themes available:"
    for theme in ${THEMES}; do
        echo "  - ${theme}"
    done
    while true; do
        read -p "[*] Type theme you want use: " THEME_NAMES
        if echo "${THEMES}" | grep -q "${THEME_NAMES}"; then
            break
        else
            echo "[*] Theme not found, please try again."
        fi
    done
    sudo sed -i "s/^Current=.*/Current=${THEME_NAMES}/" /usr/lib/sddm/sddm.conf.d/default.conf
    sudo systemctl enable sddm
}

select_theme_grub() {
    THEMES=$(ls "$DOTFILES_DIR/.root/grub/themes")
    echo "[*] Themes available:"
    for theme in ${THEMES}; do
        echo "  - ${theme}"
    done
    while true; do
        read -p "[*] Type theme you want use: " THEME_NAMES
        if echo "${THEMES}" | grep -q "${THEME_NAMES}"; then
            break
        else
            echo "[*] Theme not found, please try again."
        fi
    done
    sudo sed -i "s|#GRUB_THEME=.*|GRUB_THEME=/usr/share/grub/themes/${THEME_NAMES}/theme.txt|g" /etc/default/grub
    sudo grub-mkconfig -o /boot/grub/grub.cfg
}

install_workspace() {
    echo "[*] Installing Grub Theme ..."
    sudo mkdir -p /usr/share/grub/themes && sudo cp -a $DOTFILES_DIR/.root/grub/themes/. /usr/share/grub/themes/
    select_theme_grub
    echo "[*] Grub Theme setup done."
    sleep 3 && clear

    echo "[*] Installing Display Manager (SDDM)"
    yay -S --noconfirm sddm qt6 qt6-svg qt6-multimedia qt5-graphicaleffects qt5-multimedia qt5-quickcontrols qt5-quickcontrols2 qt5-svg gst-libav gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-plugins-base
    sudo mkdir -p /usr/share/sddm/themes && sudo cp -a $DOTFILES_DIR/.root/sddm-theme/. /usr/share/sddm/themes/
    select_theme_sddm
    echo "[*] Display Manager setup done."
    sleep 3 && clear

    echo "[*] Installing TeVim ..."
    yay -S --noconfirm lazygit fzf ripgrep neovim
    git clone https://github.com/sownteedev/TeVim.git --depth 1 ~/.config/nvim
    ln -s $DOTFILES_DIR/.config/nvim/lua/custom ~/.config/nvim/lua/custom
    echo "[*] TeVim setup done."
    sleep 3 && clear

    echo "[*] Installing Development Applications..."
    yay -S --noconfirm visual-studio-code-bin cursor-bin jetbrains-toolbox docker postman-bin blackbox-terminal
    # rm -rf ~/.config/systemd/user/graphical-session.target.wants/docker-desktop.service
    # yay -S --noconfirm vmware-keymaps open-vm-tools xf86-video-vmware xf86-input-vmmouse vmware-workstation
    # sudo systemctl enable vmware-networks vmware-usbarbitrator vmtoolsd

    echo "[*] Installing Other Applications..."
    yay -S --noconfirm vesktop-bin telegram-desktop-bin cloudflare-warp-bin spotify zen-browser-bin
	xdg-settings set default-web-browser zen.desktop
	sudo systemctl enable warp-svc.service
	warp-cli registration new

    # sh -c "$(curl -sSL https://raw.githubusercontent.com/realdtn2/zalo-linux-unofficial/main/install_curl.sh)"

    echo "[*] Environment setup complete."
    sleep 3 && clear

    echo "[*] Installing Oh My Zsh ..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
    echo "[*] Oh My Zsh installation done."
}


while [[ $# -gt 0 ]]; do
    case "$1" in
        --workspace)
			install_workspace
            exit 0
            ;;
        --env)
			setup_env
			exit 0
            ;;
        --sddm)
			select_theme_sddm
			exit 0
            ;;
        --grub)
			select_theme_grub
			exit 0
            ;;
        --dots)
			setup_dotfiles
			exit 0
            ;;
		--all)
			setup_dotfiles
			setup_env
			install_workspace
			exit 0
    esac
done

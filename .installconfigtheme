#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

readonly DOTFILES_DIR="$HOME/Dotfiles/dotf"
readonly QUICKSHELL_DIR="$HOME/Dotfiles/quickshell"
readonly INSTALLER_DRY_RUN="${INSTALLER_DRY_RUN:-0}"

# Output helpers
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

green_echo() { printf "%b\n" "${GREEN}$1${NC}"; }
red_echo() { printf "%b\n" "${RED}$1${NC}"; }
blue_echo() { printf "%b\n" "${BLUE}$1${NC}"; }

# Shared file and package helpers
retry() {
    local attempt=1
    local max_attempts=3
    local delay_seconds=5

    until "$@"; do
        if (( attempt >= max_attempts )); then
            red_echo "[!] Command failed after $max_attempts attempts."
            return 1
        fi

        blue_echo "[*] Command failed; retrying in ${delay_seconds}s ($((attempt + 1))/$max_attempts) ..."
        sleep "$delay_seconds"
        attempt=$((attempt + 1))
    done
}

start_sudo_keepalive() {
    red_echo "[*] Authenticating sudo ..."
    sudo -v
    (
        while true; do
            sleep 60
            sudo -n -v || exit
        done
    ) 2>/dev/null &
    SUDO_KEEPALIVE_PID=$!
    trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true; sudo -k' EXIT
}

safe_link() {
    local src="$1"
    local dst="$2"
    if [ -L "$dst" ] && [ "$(readlink -f -- "$dst")" = "$(readlink -f -- "$src")" ]; then
        return 0
    fi
    if [ -z "$dst" ] || [ "$dst" = "/" ] || [ "$dst" = "$HOME" ]; then
        red_echo "[!] Refusing unsafe symlink destination: ${dst:-<empty>}"
        return 1
    fi
    if [ -e "$dst" ] || [ -L "$dst" ]; then
        rm -rf -- "$dst"
    fi
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
}

run_yay() {
    if [ "$INSTALLER_DRY_RUN" = "1" ]; then
        printf '[dry-run] yay -S --needed --noconfirm'
        printf ' %q' "$@"
        printf '\n'
        return 0
    fi
    retry yay -S --needed --noconfirm "$@"
}

has_display_gpu_vendor() {
    local expected_vendor="$1"
    local pci_devices_root="${PCI_DEVICES_ROOT:-/sys/bus/pci/devices}"
    local device device_class device_vendor

    for device in "$pci_devices_root"/*; do
        [ -r "$device/class" ] && [ -r "$device/vendor" ] || continue
        read -r device_class < "$device/class"
        read -r device_vendor < "$device/vendor"
        if [[ "$device_class" == 0x03* && "$device_vendor" == "$expected_vendor" ]]; then
            return 0
        fi
    done
    return 1
}

# Quickshell runtime and optional features
install_shell_runtime() {
    local -a packages=(
        niri xwayland-satellite quickshell-git qt6-connectivity
        libnotify inotify-tools libcanberra zenity cava cliphist
        slurp wl-clipboard wtype hyprpicker gpu-screen-recorder ffmpeg imagemagick
        mesa libva-utils
        jq pciutils ddcutil matugen-bin
    )
    if has_display_gpu_vendor "0x8086"; then
        packages+=(intel-media-driver libva-intel-driver)
        blue_echo "[*] Intel GPU detected; including Intel VA-API drivers."
    else
        blue_echo "[*] No Intel GPU detected; skipping Intel-only media drivers."
    fi
    red_echo "[*] Installing required Quickshell runtime packages ..."
    run_yay "${packages[@]}"
    configure_ddc_brightness
}

configure_ddc_brightness() {
    if [ "$INSTALLER_DRY_RUN" = "1" ]; then
        printf '[dry-run] configure i2c-dev and DDC/CI access for %q\n' "$USER"
        return 0
    fi

    if ! getent group i2c >/dev/null; then
        sudo groupadd --system i2c
    fi
    printf 'i2c-dev\n' | sudo tee /etc/modules-load.d/ddcutil.conf >/dev/null
    printf '%s\n' 'KERNEL=="i2c-[0-9]*", GROUP="i2c", MODE="0660"' | sudo tee /etc/udev/rules.d/70-ddcutil-i2c.rules >/dev/null
    sudo usermod -aG i2c "$USER"
    sudo modprobe i2c-dev
    sudo udevadm control --reload-rules
    sudo udevadm trigger --subsystem-match=i2c-dev
    blue_echo "[*] DDC/CI access configured. Log out and back in once to activate the i2c group."
}

install_shell_features() {
    local -a packages=(
        tesseract tesseract-data-eng tesseract-data-vie
        mpvpaper linux-wallpaperengine-git
        tailscale cloudflare-warp-bin
        howdy-git v4l-utils
    )
    red_echo "[*] Installing optional Quickshell features ..."
    run_yay "${packages[@]}"

    if [ "$INSTALLER_DRY_RUN" = "1" ]; then
        printf '[dry-run] install howdy-face-manager -> /usr/lib/quickshell/howdy-face-manager\n'
        return 0
    fi
    if command -v howdy >/dev/null 2>&1; then
        sudo install -Dm755 "$QUICKSHELL_DIR/scripts/howdy-face-manager.py" /usr/lib/quickshell/howdy-face-manager
    else
        red_echo "[!] Howdy is not installed; skipping the Settings bridge."
    fi

    if systemctl list-unit-files tailscaled.service >/dev/null 2>&1; then
        sudo systemctl enable --now tailscaled.service

        if ! sudo tailscale set --operator="$USER"; then
            red_echo "[!] Could not set the Tailscale operator; Taildrop may report file access denied."
        fi

        if [ -f "$HOME/.config/systemd/user/taildrop-auto-receive.service" ]; then
            if systemctl --user show-environment >/dev/null 2>&1; then
                systemctl --user daemon-reload
                if tailscale status >/dev/null 2>&1; then
                    systemctl --user enable --now taildrop-auto-receive.service
                else
                    systemctl --user disable --now taildrop-auto-receive.service >/dev/null 2>&1 || true
                    blue_echo "[*] Log in with 'sudo tailscale up', then rerun this installer to enable Taildrop receiving."
                fi
            else
                blue_echo "[*] Taildrop installed; log in to a graphical session and rerun this installer to enable receiving."
            fi
        fi
    fi
    if systemctl list-unit-files warp-svc.service >/dev/null 2>&1; then
        sudo systemctl enable --now warp-svc.service
        systemctl --user enable --now warp-taskbar
    fi
}


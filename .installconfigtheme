    gsettings set org.gnome.desktop.interface icon-theme WhiteSur
    gsettings set org.gnome.desktop.interface cursor-theme Dark_Cursor

    cd ~
    sleep 3 && clear
}

# Boot and display-manager configuration
prompt_theme_selection() {
    local theme_root="$1"
    local theme_label="$2"
    local selection
    local selection_number
    local theme_path
    local index
    local -a theme_names=()

    for theme_path in "$theme_root"/*; do
        [ -d "$theme_path" ] || continue
        theme_names+=("$(basename "$theme_path")")
    done

    if (( ${#theme_names[@]} == 0 )); then
        red_echo "[!] No ${theme_label} themes found in $theme_root."
        return 1
    fi

    red_echo "[*] ${theme_label} themes available:"
    for index in "${!theme_names[@]}"; do
        blue_echo "  $((index + 1))) ${theme_names[index]}"
    done

    while true; do
        if ! read -r -p "[*] Select ${theme_label} theme [1-${#theme_names[@]}]: " selection; then
            red_echo "[!] Theme selection was cancelled."
            return 1
        fi
        if [[ "$selection" =~ ^[0-9]+$ ]]; then
            selection_number=$((10#$selection))
            if (( selection_number >= 1 && selection_number <= ${#theme_names[@]} )); then
                SELECTED_THEME_NAME="${theme_names[selection_number - 1]}"
                green_echo "[*] Selected ${theme_label} theme: $SELECTED_THEME_NAME"
                return 0
            fi
        fi
        red_echo "[!] Enter a number from 1 to ${#theme_names[@]}."
    done
}

enable_greetd_display_manager() {
    local display_manager_link="/etc/systemd/system/display-manager.service"
    local current_target=""
    local current_unit=""

    if [ -L "$display_manager_link" ]; then
        current_target=$(readlink -f -- "$display_manager_link" 2>/dev/null || true)
        current_unit=${current_target##*/}
        if [ -n "$current_unit" ] && [ "$current_unit" != "greetd.service" ]; then
            blue_echo "[*] Replacing the existing display manager: $current_unit"
            sudo systemctl disable "$current_unit" || true
        fi
    fi

    sudo systemctl enable --force greetd.service
    current_target=$(readlink -f -- "$display_manager_link" 2>/dev/null || true)
    if [ "${current_target##*/}" != "greetd.service" ]; then
        red_echo "[!] greetd did not become the active display-manager service."
        return 1
    fi
}

install_greetd() {
    local greetd_pam_source="$DOTFILES_DIR/.root/greetd/pam/greetd"
    local greeter_source="$QUICKSHELL_DIR/widget/greeter"
    local greeter_install_dir="/usr/share/quickshell-greeter"
    local greeter_theme_dir="/var/lib/quickshell-greeter"
    local greeter_theme_file="$greeter_theme_dir/colors.json"
    local greeter_background_file="$greeter_theme_dir/background.json"
    local greeter_profile_file="$greeter_theme_dir/profile.json"
    local greeter_runtime_dir="$greeter_theme_dir/runtime"
    local config_temp=""
    local required_command=""
    # Keep the standalone --greetd path self-contained on a fresh installation.
    local -a packages=(
        greetd cage quickshell-git qt6-multimedia qt6-5compat qt6-imageformats qt6-avif-image-plugin
        ffmpeg matugen-bin gnome-keyring niri python upower rsync inter-font ttf-nerd-fonts-symbols
    )

    if [ "$(id -u)" -eq 0 ] || [ "$USER" = "root" ]; then
        red_echo "[!] Run this installer as the target desktop user, not as root."
        return 1
    fi
    if [[ ! "$USER" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || ! getent passwd "$USER" >/dev/null; then
        red_echo "[!] Refusing to write an invalid greetd user name: $USER"
        return 1
    fi
    if [ ! -f "$greeter_source/shell.qml" ]; then
        red_echo "[!] Quickshell greeter source not found: $greeter_source"
        return 1
    fi
    if [ ! -f "$greeter_source/scripts/list_sessions.py" ] || [ ! -f "$greeter_source/qmldir" ]; then
        red_echo "[!] Quickshell greeter source is incomplete: $greeter_source"
        return 1
    fi
    if [ ! -f "$greetd_pam_source" ]; then
        red_echo "[!] greetd PAM configuration not found: $greetd_pam_source"
        return 1
    fi

    if [ "$INSTALLER_DRY_RUN" != "1" ] && ! command -v yay >/dev/null 2>&1; then
        red_echo "[!] yay is required. Run the driver installation stage first."
        return 1
    fi
    run_yay "${packages[@]}"
    if [ "$INSTALLER_DRY_RUN" = "1" ]; then
        printf '[dry-run] deploy %q to %q with stale files removed\n' "$greeter_source" "$greeter_install_dir"
        printf '[dry-run] configure greetd state under %q for user %q and group greeter\n' "$greeter_theme_dir" "$USER"
        printf '[dry-run] install PAM configuration from %q\n' "$greetd_pam_source"
        printf '[dry-run] replace display-manager.service with greetd.service\n'
        return 0
    fi

    if [ ! -f /usr/lib/sysusers.d/greetd.conf ]; then
        red_echo "[!] greetd installed without its sysusers configuration."
        return 1
    fi
    if ! getent passwd greeter >/dev/null || ! getent group greeter >/dev/null; then
        sudo systemd-sysusers /usr/lib/sysusers.d/greetd.conf
    fi
    if ! getent passwd greeter >/dev/null || ! getent group greeter >/dev/null; then
        red_echo "[!] The greetd greeter account could not be created."
        return 1
    fi
    if getent group video >/dev/null && ! id -nG greeter | tr ' ' '\n' | grep -qx video; then
        sudo usermod -aG video greeter
    fi

    for required_command in cage ffmpeg matugen quickshell python3 niri-session systemd-cat; do
        if ! command -v "$required_command" >/dev/null 2>&1; then
            red_echo "[!] Required greetd command is missing after installation: $required_command"
            return 1
        fi
    done

    sudo install -d -m 0755 "$greeter_install_dir" /etc/greetd /etc/pam.d
    sudo install -d -o "$USER" -g greeter -m 2750 "$greeter_theme_dir"
    sudo chown "$USER:greeter" "$greeter_theme_dir"
    sudo chmod 2750 "$greeter_theme_dir"
    sudo find "$greeter_theme_dir" -maxdepth 1 -type f -exec chown "$USER:greeter" {} +
    sudo find "$greeter_theme_dir" -maxdepth 1 -type f -exec chmod 0640 {} +
    sudo install -d -o greeter -g greeter -m 0700 \
        "$greeter_runtime_dir" \
        "$greeter_runtime_dir/cache" \
        "$greeter_runtime_dir/config" \
        "$greeter_runtime_dir/data"
    sudo chown -R greeter:greeter "$greeter_runtime_dir"
    sudo find "$greeter_runtime_dir" -type d -exec chmod 0700 {} +

    sudo rsync -a --delete "$greeter_source/" "$greeter_install_dir/"
    sudo chown -R root:root "$greeter_install_dir"
    sudo find "$greeter_install_dir" -type d -exec chmod 0755 {} +
    sudo find "$greeter_install_dir" -type f -exec chmod 0644 {} +
    sudo install -m 0644 "$greetd_pam_source" /etc/pam.d/greetd
    config_temp=$(mktemp /tmp/quickshell-greetd-config.XXXXXX)
    cat > "$config_temp" << EOF
[terminal]
vt = 1

[default_session]
command = "env HOME=$greeter_runtime_dir XDG_CACHE_HOME=$greeter_runtime_dir/cache XDG_CONFIG_HOME=$greeter_runtime_dir/config XDG_DATA_HOME=$greeter_runtime_dir/data GREETD_DEFAULT_USER=$USER GREETD_SESSION_NAME=Niri GREETD_THEME_PATH=$greeter_theme_file GREETD_BACKGROUND_PATH=$greeter_background_file GREETD_PROFILE_PATH=$greeter_profile_file systemd-cat --identifier=quickshell-greeter cage -d -s -m extend -- quickshell --no-color --path $greeter_install_dir"
user = "greeter"
EOF
    if ! python3 -c 'import pathlib, sys, tomllib; tomllib.loads(pathlib.Path(sys.argv[1]).read_text())' "$config_temp"; then
        rm -f -- "$config_temp"
        red_echo "[!] Generated greetd configuration is not valid TOML."
        return 1
    fi
    if ! sudo install -m 0644 "$config_temp" /etc/greetd/config.toml; then
        rm -f -- "$config_temp"
        return 1
    fi
    rm -f -- "$config_temp"

    enable_greetd_display_manager
    green_echo "[*] Greetd is configured for the next boot."
}

select_theme_grub() {
    local grub_defaults="/etc/default/grub"
    local selected_theme
    local theme_name
    local module
    local -a image_modules=()

    prompt_theme_selection "$DOTFILES_DIR/.root/grub/themes" "GRUB"
    theme_name="$SELECTED_THEME_NAME"
    selected_theme="$DOTFILES_DIR/.root/grub/themes/$theme_name"
    find "$selected_theme" -type f -iname '*.png' -print -quit | grep -q . && image_modules+=(png)
    find "$selected_theme" -type f \( -iname '*.jpg' -o -iname '*.jpeg' \) -print -quit | grep -q . && image_modules+=(jpeg)
    find "$selected_theme" -type f -iname '*.tga' -print -quit | grep -q . && image_modules+=(tga)

    for module in "${image_modules[@]}"; do
        if grep -Eq "^GRUB_PRELOAD_MODULES=\"([^\"]*[[:space:]])?${module}([[:space:]][^\"]*)?\"" "$grub_defaults"; then
            continue
        fi
        if grep -q '^GRUB_PRELOAD_MODULES="' "$grub_defaults"; then
            sudo sed -i -E "s/^(GRUB_PRELOAD_MODULES=\"[^\"]*)\"/\\1 ${module}\"/" "$grub_defaults"
        else
            printf 'GRUB_PRELOAD_MODULES="%s"\n' "$module" | sudo tee -a "$grub_defaults" >/dev/null
        fi
    done

    sudo sed -i "s|^#\?GRUB_THEME=.*|GRUB_THEME=/usr/share/grub/themes/${theme_name}/theme.txt|g" "$grub_defaults"
    sudo grub-mkconfig -o /boot/grub/grub.cfg
}

# Application configuration
patch_desktop_entry() {
    local app="$1"
    local flags="$2"
    local target_dir="$3"
    local original="/usr/share/applications/$app"
    local target="$target_dir/$app"

    [ -f "$original" ] || return 0
    cp "$original" "$target"
    if ! grep -q "ozone-platform-hint" "$target"; then
        sed -i '/^Exec=/s/ / '"$flags"' /' "$target"
    fi
}

patch_wayland_flags() {
    local target_dir="$HOME/.local/share/applications"
    local base_flags="--test-type --ozone-platform-hint=wayland --ignore-gpu-blocklist --enable-wayland-ime --disable-gpu-sandbox --password-store=gnome-libsecret"
    # local brave_flags="--ozone-platform-hint=wayland --enable-wayland-ime --password-store=gnome-libsecret"
    local electron_flags="$base_flags --gtk-version=4"
    local -a electron_apps=(
        code.desktop postman.desktop vesktop.desktop
    )
    # local -a brave_apps=(brave-browser.desktop)
    local app

    mkdir -p "$target_dir"

    for app in "${electron_apps[@]}"; do
        patch_desktop_entry "$app" "$electron_flags" "$target_dir"
    done

    # for app in "${brave_apps[@]}"; do
    #     patch_desktop_entry "$app" "$brave_flags" "$target_dir"
    # done
}


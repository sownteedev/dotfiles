#!/bin/bash

# Niri Transform - Rotate display orientation (sownteedev)
# Usage: transform left|right

CONFIG="$HOME/.config/niri/include/outputs.kdl"

FOCUSED_JSON=$(niri msg -j focused-output)
OUTPUT=$(echo "$FOCUSED_JSON" | jq -r '.name')
HW_ID=$(echo "$FOCUSED_JSON" | jq -r '"\(.make) \(.model) \(.serial // "Unknown")"')

TARGET_OUTPUT="$OUTPUT"
if [[ "$OUTPUT" == eDP-* ]]; then
    TARGET_OUTPUT="$HW_ID"
fi

current=$(awk "/output \"$TARGET_OUTPUT\" {/,/}/{if (\$1==\"transform\") print \$2}" "$CONFIG" | tr -d '"')

order=(normal 90 180 270)

if [[ "$1" == "left" ]]; then
    dir=1
elif [[ "$1" == "right" ]]; then
    dir=-1
else
    exit 1
fi

idx=0
for i in {1..4}; do
    if [[ "${order[$i-1]}" == "$current" ]]; then
        idx=$i
        break
    fi
done

if [[ $idx -eq 0 ]]; then
    idx=1
fi

next=$(( (idx - 1 + dir + 4) % 4 ))
next_transform="${order[$next]}"

if ! grep -q "output \"$TARGET_OUTPUT\" {" "$CONFIG"; then
    echo -e "\noutput \"$TARGET_OUTPUT\" {\n    mode \"2560x1600@60.000\"\n    scale 1.0\n    transform \"normal\"\n    position x=0 y=0\n}" >> "$CONFIG"
fi

sed -i "/output \"$TARGET_OUTPUT\" {/,/}/{s/transform \".*\"/transform \"$next_transform\"/}" "$CONFIG"

if [[ "$OUTPUT" == eDP-* ]]; then
    for alt in "eDP-1" "eDP-2"; do
        if grep -q "output \"$alt\" {" "$CONFIG"; then
            sed -i "/output \"$alt\" {/,/}/{s/transform \".*\"/transform \"$next_transform\"/}" "$CONFIG"
        fi
    done
fi

window-rule {
    geometry-corner-radius 15
    clip-to-geometry true
}

// Frequently-used utility apps that are usually better as floating.
window-rule {
    match app-id=r"^(pavucontrol|neovide|vmware|spotify|blueman-manager|mpv|org\.gnome\.Calculator|org\.gnome\.Settings|io\.missioncenter\.MissionCenter|org\.gnome\.Nautilus|org\.gnome\.Loupe|org\.gnome\.FileRoller|org\.gnome\.NautilusPreviewer)$"
    open-floating true
}

// SownteeShell Settings is an xdg-toplevel so it can resize and maximize like a
// regular application while retaining the shell's custom MD3 surface.
window-rule {
    match title="^SownteeShell Settings$"
    open-floating true
    default-column-width { fixed 1240; }
    default-window-height { fixed 860; }
    geometry-corner-radius 26
    clip-to-geometry true
    background-effect {
        xray false
    }
}

// SownteeShell Calendar uses the same regular, resizable application surface as
// Settings while leaving a little working-area context around the window.
window-rule {
    match title="^SownteeShell Calendar$"
    open-floating true
    default-column-width { proportion 0.90; }
    default-window-height { proportion 0.88; }
    geometry-corner-radius 26
    clip-to-geometry true
    background-effect {
        xray false
    }
}

// Fill the target output's working area on open while remaining a regular
// movable and resizable floating window. The working area excludes the bar.
window-rule {
    match title="^SownteeShell Screenshot Editor$"
    open-floating true
    open-maximized false
    open-maximized-to-edges false
    open-fullscreen false
    open-focused true
    default-column-width { proportion 1.0; }
    default-window-height { proportion 1.0; }
    default-floating-position x=0 y=0 relative-to="top-left"
}

window-rule {
    match app-id=r".*\.exe$"
    open-floating true
}

// Telegram Media Viewer
window-rule {
    match app-id=r"^org\.telegram\.desktop$" title="^Media viewer$"
    open-floating true
}

window-rule {
	match app-id=r"^com\.raggesilver\.BlackBox$"
	open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 750; }
}

// Picture in Picture for various browsers
window-rule {
    match title="^[Pp]icture[- ][Ii]n[- ][Pp]icture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

// Privacy example: hide password managers from all screenshots and screencasts.
/-window-rule {
    match app-id=r"^org\.keepassxc\.KeePassXC$"
    match app-id=r"^org\.gnome\.World\.Secrets$"
    block-out-from "screen-capture"
    // block-out-from "screencast"
}

window-rule {
    match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

/////////////// EXAMPLE /////////////////////
// Window-rule reference. Replace the matcher and keep only the options needed.
/-window-rule {
    match app-id="example"
    // exclude title="Settings"

    default-column-width { proportion 0.75; }
    default-window-height { fixed 700; }
    open-on-output "DP-1"
    open-on-workspace "browser"
    open-maximized true
    open-maximized-to-edges false
    open-fullscreen false
    open-floating false
    open-focused true

    opacity 0.95
    variable-refresh-rate true
    default-column-display "tabbed"
    default-floating-position x=40 y=40 relative-to="top-left"
    scroll-factor 1.0

    focus-ring {
        on
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000070"
    }

    geometry-corner-radius 15
    clip-to-geometry true
    min-width 320
    min-height 180
    max-width 1920
    max-height 1080
}

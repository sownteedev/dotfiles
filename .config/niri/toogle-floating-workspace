#!/bin/bash

# Niri Toggle Floating Workspace - Toggle floating status for windows in current workspace
# Also updates include/rule.kdl window-rule open-floating behavior
# Usage: toogle-floating-workspace

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/include/rule.kdl"
MANAGED_MARKER="managed-by-toggle-floating-workspace"

get_workspace_data() {
    niri msg --json windows | jq --argjson workspaces "$(niri msg --json workspaces)" '
        [.[] | select(.workspace_id == ($workspaces[] | select(.is_active) | .id))] // []'
}

# App-level rules with open-floating true (without title matcher) should remain untouched.
get_protected_app_ids() {
    if [ ! -f "$CONFIG_FILE" ]; then
        return 0
    fi

    awk '
    function reset_rule_state() {
        in_window_rule = 0
        depth = 0
        has_open_floating = 0
        has_title_match = 0
        delete app_tokens
        app_count = 0
    }
    function add_app_token(token,    n, i, candidate) {
        sub(/^\^/, "", token)
        sub(/\$$/, "", token)
        if (token ~ /^\(.*\)$/) {
            sub(/^\(/, "", token)
            sub(/\)$/, "", token)
            n = split(token, parts, /\|/)
            for (i = 1; i <= n; i++) {
                candidate = parts[i]
                gsub(/\\\./, ".", candidate)
                if (candidate ~ /^[A-Za-z0-9._-]+$/) app_tokens[++app_count] = candidate
            }
        } else {
            candidate = token
            gsub(/\\\./, ".", candidate)
            if (candidate ~ /^[A-Za-z0-9._-]+$/) app_tokens[++app_count] = candidate
        }
    }
    function process_app_tokens_from_line(line,    token) {
        while (match(line, /app-id=([^ ]+)/)) {
            token = substr(line, RSTART + 7, RLENGTH - 7)
            line = substr(line, RSTART + RLENGTH)
            if (token ~ /^r#".*"#$/) {
                sub(/^r#"/, "", token)
                sub(/"#[[:space:]]*$/, "", token)
                add_app_token(token)
            } else if (token ~ /^".*"$/) {
                sub(/^"/, "", token)
                sub(/"[[:space:]]*$/, "", token)
                add_app_token(token)
            }
        }
    }
    function flush_rule_if_needed(    i) {
        if (in_window_rule && has_open_floating && !has_title_match) {
            for (i = 1; i <= app_count; i++) print app_tokens[i]
        }
    }
    BEGIN { reset_rule_state() }
    {
        line = $0
        if (!in_window_rule && line ~ /^[[:space:]]*window-rule[[:space:]]*\{/) {
            reset_rule_state()
            in_window_rule = 1
            depth = 1
            if (line ~ /open-floating[[:space:]]+true/ && line !~ /managed-by-toggle-floating-workspace/) has_open_floating = 1
            if (line ~ /title=/) has_title_match = 1
            process_app_tokens_from_line(line)
            next
        }
        if (in_window_rule) {
            if (line ~ /open-floating[[:space:]]+true/ && line !~ /managed-by-toggle-floating-workspace/) has_open_floating = 1
            if (line ~ /title=/) has_title_match = 1
            process_app_tokens_from_line(line)
            depth += gsub(/\{/, "{", line) - gsub(/\}/, "}", line)
            if (depth <= 0) {
                flush_rule_if_needed()
                reset_rule_state()
            }
        }
    }
    END { flush_rule_if_needed() }
    ' "$CONFIG_FILE" | sort -u
}

update_config_floating() {
    local new_floating_state=$1
    if [ ! -f "$CONFIG_FILE" ]; then
        return 1
    fi
    if [ "$new_floating_state" = "true" ]; then
        if grep -q "$MANAGED_MARKER" "$CONFIG_FILE"; then
            sed -i "s|^\s*open-floating .*${MANAGED_MARKER}.*$|\topen-floating true // ${MANAGED_MARKER}|" "$CONFIG_FILE"
        else
            sed -i "/^\s*clip-to-geometry true/a\\\topen-floating true // ${MANAGED_MARKER}" "$CONFIG_FILE"
        fi
    else
        sed -i "/${MANAGED_MARKER}/d" "$CONFIG_FILE"
    fi
}

is_open_floating_enabled() {
    grep -q "^\s*open-floating true .*${MANAGED_MARKER}" "$CONFIG_FILE"
}

toggle_floating_workspace() {
    local workspace_data
    workspace_data=$(get_workspace_data)
    local window_count
    window_count=$(echo "$workspace_data" | jq 'length')

    if [ "$window_count" -eq 0 ]; then
        if is_open_floating_enabled; then
            update_config_floating "false"
        else
            update_config_floating "true"
        fi
        exit 0
    fi

    declare -A protected_app_ids=()
    while IFS= read -r app_id; do
        [ -n "$app_id" ] && protected_app_ids["$app_id"]=1
    done < <(get_protected_app_ids)

    local floating_count=0
    local managed_window_count=0
    local window_ids=()

    while IFS= read -r window_data; do
        [ -z "$window_data" ] && continue
        local window_id
        local is_floating
        local app_id
        window_id=$(echo "$window_data" | cut -d'|' -f1)
        is_floating=$(echo "$window_data" | cut -d'|' -f2)
        app_id=$(echo "$window_data" | cut -d'|' -f3)

        if [ -n "${protected_app_ids[$app_id]}" ]; then
            continue
        fi

        window_ids+=("$window_id")
        managed_window_count=$((managed_window_count + 1))
        if [ "$is_floating" = "true" ]; then
            floating_count=$((floating_count + 1))
        fi
    done <<< "$(echo "$workspace_data" | jq -r '.[] | "\(.id)|\(.is_floating)|\(.app_id // "")"')"

    if [ "$managed_window_count" -eq 0 ]; then
        if is_open_floating_enabled; then
            update_config_floating "false"
        else
            update_config_floating "true"
        fi
        exit 0
    fi

    local target_windows_floating
    if [ "$floating_count" -eq 0 ]; then
        target_windows_floating="true"
    elif [ "$floating_count" -eq "$managed_window_count" ]; then
        target_windows_floating="false"
    else
        if is_open_floating_enabled; then
            target_windows_floating="true"
        else
            target_windows_floating="false"
        fi
    fi

    while IFS= read -r window_data; do
        [ -z "$window_data" ] && continue
        local window_id
        local is_floating
        local app_id
        window_id=$(echo "$window_data" | cut -d'|' -f1)
        is_floating=$(echo "$window_data" | cut -d'|' -f2)
        app_id=$(echo "$window_data" | cut -d'|' -f3)

        if [ -n "${protected_app_ids[$app_id]}" ]; then
            continue
        fi
        if [ "$is_floating" != "$target_windows_floating" ]; then
            niri msg action toggle-window-floating --id "$window_id"
        fi
    done <<< "$(echo "$workspace_data" | jq -r '.[] | "\(.id)|\(.is_floating)|\(.app_id // "")"')"

    if [ "$target_windows_floating" = "false" ]; then
        local window_id
        for window_id in "${window_ids[@]}"; do
            niri msg action focus-window --id "$window_id" >/dev/null 2>&1
            niri msg action maximize-column >/dev/null 2>&1
        done
    fi

    update_config_floating "$target_windows_floating"
}

main() {
    local action=$1
    case "$action" in
        "")
            toggle_floating_workspace
            ;;
        *)
            exit 0
            ;;
    esac
}

main "$@"

#!/bin/bash
# Niri App Switcher - Focus app by position (sownteedev)
# Usage: focus-app.sh <number>  (1-9)

set -euo pipefail

focus_app() {
    local num=${1:-}
    
    # Validate input
    [[ "$num" =~ ^[1-9]$ ]] || exit 1
    
    # Get active workspace ID
    local ws_id=$(niri msg --json workspaces | jq -r '.[] | select(.is_active) | .id')
    [[ -n "$ws_id" ]] || exit 1
    
    # Get target window ID - sorted by pos_in_scrolling_layout (same as Workspace.tsx)
    local win_id=$(niri msg --json windows | jq -r --arg ws "$ws_id" --argjson n "$num" '
        [.[] | select(.workspace_id == ($ws | tonumber))] | 
        sort_by(.layout.pos_in_scrolling_layout[0] // 999999) | 
        .[$n - 1].id // empty
    ')
    
    [[ -n "$win_id" ]] || exit 1
    
    niri msg action focus-window --id "$win_id"
}

focus_app "$1"

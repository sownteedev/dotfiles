#!/usr/bin/env bash

# WARNING: THIS IS MY PERSONAL SCRIPT WHEN I REINSTALL ARCH, IT MAY NOT WORK FOR YOU!

# Fail fast and reduce word-splitting issues
set -euo pipefail
IFS=$'\n\t'

# Output helpers
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

green_echo() { printf "%b\n" "${GREEN}$1${NC}"; }
red_echo() { printf "%b\n" "${RED}$1${NC}"; }
blue_echo() { printf "%b\n" "${BLUE}$1${NC}"; }

# Installation helpers
retry() {
    local attempt=1
    local max_attempts=3
    local delay_seconds=5

    until "$@"; do
        if (( attempt >= max_attempts )); then
            red_echo "[!] Command failed after $max_attempts attempts."
            return 1
        fi

        blue_echo "[*] Command failed; retrying in ${delay_seconds}s ($((attempt + 1))/$max_attempts) ..."
        sleep "$delay_seconds"
        attempt=$((attempt + 1))
    done
}

has_display_gpu_vendor() {
    local expected_vendor="$1"
    local pci_devices_root="${PCI_DEVICES_ROOT:-/sys/bus/pci/devices}"
    local device device_class device_vendor

    for device in "$pci_devices_root"/*; do
        [ -r "$device/class" ] && [ -r "$device/vendor" ] || continue
        read -r device_class < "$device/class"
        read -r device_vendor < "$device/vendor"
        if [[ "$device_class" == 0x03* && "$device_vendor" == "$expected_vendor" ]]; then
            return 0
        fi
    done
    return 1
}

display_gpu_kernel_driver() {
    local expected_vendor="$1"
    local pci_devices_root="${PCI_DEVICES_ROOT:-/sys/bus/pci/devices}"
    local device device_class device_vendor driver_path

    for device in "$pci_devices_root"/*; do
        [ -r "$device/class" ] && [ -r "$device/vendor" ] || continue
        read -r device_class < "$device/class"
        read -r device_vendor < "$device/vendor"
        if [[ "$device_class" != 0x03* || "$device_vendor" != "$expected_vendor" || ! -L "$device/driver" ]]; then
            continue
        fi
        driver_path=$(readlink -f -- "$device/driver") || continue
        basename "$driver_path"
        return 0
    done
    return 1
}

is_dell_g16_7620() {
    local dmi_root="${DMI_ROOT:-/sys/class/dmi/id}"
    local system_vendor product_name

    [ -r "$dmi_root/sys_vendor" ] && [ -r "$dmi_root/product_name" ] || return 1
    read -r system_vendor < "$dmi_root/sys_vendor"
    read -r product_name < "$dmi_root/product_name"
    [ "$system_vendor" = "Dell Inc." ] && [ "$product_name" = "Dell G16 7620" ]
}

install_nautilus_taildrop() {
    local taildrop_repo="https://github.com/Balazsmi/Nautilus-Taildrop.git"
    local taildrop_commit="769899fd08e5f217f1a0bfef5d8c04af21956633"
    local temp_dir source_dir installed_commit source_file

    if ! command -v git >/dev/null 2>&1; then
        red_echo "[!] Git is required to install Nautilus Taildrop."
        return 1
    fi

    temp_dir=$(mktemp -d)
    source_dir="$temp_dir/source"

    if ! git init --quiet "$source_dir" \
        || ! git -C "$source_dir" remote add origin "$taildrop_repo" \
        || ! git -C "$source_dir" fetch --quiet --depth 1 origin "$taildrop_commit" \
        || ! git -C "$source_dir" checkout --quiet --detach FETCH_HEAD; then
        rm -rf -- "$temp_dir"
        red_echo "[!] Failed to download Nautilus Taildrop."
        return 1
    fi

    installed_commit=$(git -C "$source_dir" rev-parse HEAD)
    if [ "$installed_commit" != "$taildrop_commit" ]; then
        rm -rf -- "$temp_dir"
        red_echo "[!] Nautilus Taildrop commit verification failed."
        return 1
    fi

    for source_file in \
        send-via-taildrop.py \
        taildrop-auto-receive.sh \
        nautilus-taildrop.py \
        taildrop-auto-receive.service; do
        if [ ! -f "$source_dir/$source_file" ]; then
            rm -rf -- "$temp_dir"
            red_echo "[!] Nautilus Taildrop is missing $source_file."
            return 1
        fi
    done

    if ! install -Dm755 "$source_dir/send-via-taildrop.py" "$HOME/.local/bin/send-via-taildrop" \
        || ! install -Dm755 "$source_dir/taildrop-auto-receive.sh" "$HOME/.local/bin/taildrop-auto-receive.sh" \
        || ! install -Dm644 "$source_dir/nautilus-taildrop.py" "$HOME/.local/share/nautilus-python/extensions/nautilus-taildrop.py" \
        || ! install -Dm644 "$source_dir/taildrop-auto-receive.service" "$HOME/.config/systemd/user/taildrop-auto-receive.service"; then
        rm -rf -- "$temp_dir"
        red_echo "[!] Failed to install Nautilus Taildrop files."
        return 1
    fi

    rm -rf -- "$temp_dir"
    green_echo "[*] Nautilus Taildrop installed."
}

# Authenticate once, then keep the sudo timestamp alive while the installer runs.
red_echo "[*] Authenticating sudo ..."

# File manager
red_echo "[*] Installing file manager ..."
retry sudo pacman -S --needed --noconfirm nautilus nautilus-python nautilus-my-computer sushi nautilus-image-converter nautilus-copy-path nautilus-open-in-ide nautilus-admin-gtk4 git-nautilus-icons ffmpegthumbnailer tumbler eza zip gzip tar unzip unrar mpv dconf xdg-user-dirs gvfs
install_nautilus_taildrop

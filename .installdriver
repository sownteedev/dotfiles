if is_dell_g16_7620; then
    cd ~
    red_echo "[*] Dell G16 7620 detected; fixing audio driver ..."
    retry sudo pacman -S --needed --noconfirm rsync
    mkdir -p "$HOME/old-sof-backup"
    sudo mv /lib/firmware/intel/sof* "$HOME/old-sof-backup" || true
    sudo mv /usr/local/bin/sof-* "$HOME/old-sof-backup" || true
    sudo chown -R "$USER":"$USER" "$HOME/old-sof-backup" || true

    git clone https://github.com/thesofproject/sof-bin.git && cd sof-bin/v2.1.x
    sudo rsync -a sof*v2.1.1 /lib/firmware/intel/ || true
    sudo ln -sfn sof-v2.1.1 /lib/firmware/intel/sof || true
    sudo ln -sfn sof-tplg-v2.1.1 /lib/firmware/intel/sof-tplg || true
    sudo rsync tools-v2.1.1/* /usr/local/bin || true

    cd ~ && git clone https://github.com/thesofproject/alsa-ucm-conf.git && cd alsa-ucm-conf
    if [ -d /usr/share/alsa/ucm ]; then
        sudo rm -r /usr/share/alsa/ucm
    fi
    sudo mv ./ucm /usr/share/alsa

    cd ~ && sudo rm -rf sof-bin alsa-ucm-conf || true
    green_echo "[*] Done."
    sleep 3 && clear
else
    blue_echo "[*] This is not a Dell G16 7620; skipping the model-specific audio workaround."
fi

# Graphics drivers
red_echo ">>> Config graphics drivers..."
sudo sed -i '/\[multilib\]/,/Include/ s/^#//' /etc/pacman.conf
retry sudo pacman -Syu --needed --noconfirm
graphics_packages=(mesa lib32-mesa mesa-utils vulkan-icd-loader lib32-vulkan-icd-loader)
initramfs_gpu_modules=()

if has_display_gpu_vendor "0x8086"; then
    green_echo "[*] Intel GPU detected."
    graphics_packages+=(vulkan-intel lib32-vulkan-intel intel-media-driver)
    if intel_kernel_driver=$(display_gpu_kernel_driver "0x8086"); then
        case "$intel_kernel_driver" in
            i915|xe)
                initramfs_gpu_modules+=("$intel_kernel_driver")
                blue_echo "[*] Intel kernel driver detected: $intel_kernel_driver"
                ;;
            *)
                initramfs_gpu_modules+=(i915)
                blue_echo "[*] Unknown Intel kernel driver '$intel_kernel_driver'; using i915."
                ;;
        esac
    else
        initramfs_gpu_modules+=(i915)
        blue_echo "[*] Intel kernel driver is not bound; using i915."
    fi
fi

if has_display_gpu_vendor "0x1002"; then
    green_echo "[*] AMD GPU detected."
    graphics_packages+=(vulkan-radeon lib32-vulkan-radeon)
    initramfs_gpu_modules+=(amdgpu)
fi

if has_display_gpu_vendor "0x10de"; then
    green_echo "[*] NVIDIA GPU detected."
    graphics_packages+=(nvidia-open-dkms nvidia-utils nvidia-settings lib32-nvidia-utils nvidia-prime)
    initramfs_gpu_modules+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
    sudo sed -i 's/loglevel=3 quiet/quiet nvidia-drm.modeset=1 nvidia-drm.fbdev=1/' /etc/default/grub
else
    blue_echo "[*] No NVIDIA GPU detected; skipping NVIDIA packages and boot parameters."
    niri_environment_file="$HOME/Dotfiles/dotf/.config/niri/include/environment.kdl"
    if [ -f "$niri_environment_file" ]; then
        sed -i -E '/^[[:space:]]*(GBM_BACKEND|__NV_PRIME_RENDER_OFFLOAD|LIBVA_DRIVER_NAME|__GLX_VENDOR_LIBRARY_NAME)[[:space:]]/ s|^([[:space:]]*)|\1// |' "$niri_environment_file"
        blue_echo "[*] Disabled NVIDIA-only Niri environment variables."
    fi
fi

retry sudo pacman -S --needed --noconfirm "${graphics_packages[@]}"

if (( ${#initramfs_gpu_modules[@]} > 0 )); then
    printf -v initramfs_module_list '%s ' "${initramfs_gpu_modules[@]}"
    initramfs_module_list=${initramfs_module_list% }
    sudo sed -i "s/^MODULES=.*/MODULES=($initramfs_module_list)/" /etc/mkinitcpio.conf
else
    blue_echo "[*] No supported PCI display GPU detected; preserving the existing initramfs module list."
fi

sudo mkinitcpio -P
sudo grub-mkconfig -o /boot/grub/grub.cfg
sleep 3 && clear

# Secure Boot
red_echo ">>> Config Secure Boot..."
sudo grub-install --target=x86_64-efi --efi-directory=/boot \
    --bootloader-id=GRUB --modules="tpm" --disable-shim-lock

sudo grub-install --target=x86_64-efi --efi-directory=/boot \
    --bootloader-id=GRUB --modules="tpm" --disable-shim-lock \
    --removable --no-nvram
sudo grub-mkconfig -o /boot/grub/grub.cfg

# Create keys and sign Secure Boot
if [[ ! -f /var/lib/sbctl/keys/db/db.key ]]; then
    sudo sbctl create-keys
fi
sudo sbctl sign -s /boot/EFI/GRUB/grubx64.efi
sudo sbctl sign -s /boot/EFI/BOOT/BOOTX64.EFI
for k in /boot/vmlinuz-*; do
    if [ -f "$k" ]; then
        sudo sbctl sign -s "$k"
    fi
done

# Key enrollment is only accepted while the firmware is in Setup Mode.
# Treat enrollment as optional here so firmware-specific failures do not stop
# the rest of the installation under `set -e`.
SECURE_BOOT_STATUS=""
SECURE_BOOT_SETUP_MODE=""
SECURE_BOOT_ENABLED=""

if ! mountpoint -q /sys/firmware/efi/efivars; then
    red_echo "[!] EFI variables are unavailable; skipping Secure Boot key enrollment."
    blue_echo "[*] Boot in UEFI mode and make sure efivarfs is mounted before enrolling keys."
elif [ ! -f /var/lib/sbctl/keys/PK/PK.key ] \
    || [ ! -f /var/lib/sbctl/keys/PK/PK.pem ] \
    || [ ! -f /var/lib/sbctl/keys/KEK/KEK.key ] \
    || [ ! -f /var/lib/sbctl/keys/KEK/KEK.pem ] \
    || [ ! -f /var/lib/sbctl/keys/db/db.key ] \
    || [ ! -f /var/lib/sbctl/keys/db/db.pem ]; then
    red_echo "[!] Secure Boot key set is incomplete; skipping enrollment."
elif ! SECURE_BOOT_STATUS="$(sbctl status --json 2>/dev/null)"; then
    red_echo "[!] Unable to read the Secure Boot firmware state; skipping enrollment."
elif ! SECURE_BOOT_SETUP_MODE="$(jq -r '.setup_mode | tostring' <<< "$SECURE_BOOT_STATUS" 2>/dev/null)" \
    || ! SECURE_BOOT_ENABLED="$(jq -r '.secure_boot | tostring' <<< "$SECURE_BOOT_STATUS" 2>/dev/null)" \
    || [[ "$SECURE_BOOT_SETUP_MODE" != "true" && "$SECURE_BOOT_SETUP_MODE" != "false" ]] \
    || [[ "$SECURE_BOOT_ENABLED" != "true" && "$SECURE_BOOT_ENABLED" != "false" ]]; then
    red_echo "[!] Unable to parse the Secure Boot firmware state; skipping enrollment."
elif [ "$SECURE_BOOT_SETUP_MODE" != "true" ]; then
    if [ "$SECURE_BOOT_ENABLED" = "true" ]; then
        green_echo "[*] Secure Boot is already enabled and Setup Mode is disabled; skipping key enrollment."
    else
        red_echo "[!] Firmware is not in Setup Mode; skipping Secure Boot key enrollment."
        blue_echo "[*] Clear the Secure Boot keys (at least PK) in UEFI firmware, then rerun this step."
    fi
elif sudo sbctl enroll-keys -m --ignore-immutable; then
    green_echo "[*] Secure Boot keys enrolled successfully."
else
    red_echo "[!] Secure Boot key enrollment failed; continuing installation."
    blue_echo "[*] Check firmware key management, Option ROM warnings, and EFI variable permissions."
fi
sleep 3 && clear


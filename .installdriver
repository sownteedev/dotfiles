(
    while true; do
        sleep 60
        sudo -n -v || exit
    done
) 2>/dev/null &
SUDO_KEEPALIVE_PID=$!
trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true; sudo -k' EXIT


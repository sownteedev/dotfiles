printf '[connection]\nwifi.powersave = 2\n' | sudo tee "$LOC" >/dev/null
green_echo "[*] Done."
sleep 3 && clear

# Bluetooth
red_echo "[*] Installing bluetooth driver ..."
retry sudo pacman -S --needed --noconfirm bluez bluez-utils bluez-libs bluez-deprecated-tools
sudo systemctl enable --now bluetooth.service
systemctl --user enable --now mpris-proxy.service
green_echo "[*] Done."

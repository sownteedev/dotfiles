# Install driver web mouse keyboard
red_echo "[*] Installing driver mouse keyboard ..."
RULE_CONTENT='# AULA WIN 60 HE
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="c365", MODE="0666"

# MCHOSE A7 Ultra
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="5253", ATTRS{idProduct}=="1020", MODE="0666"'
echo "$RULE_CONTENT" | sudo tee /etc/udev/rules.d/99-webhid.rules > /dev/null


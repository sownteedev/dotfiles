#!/bin/sh

set -eu

print_usage() {
    cat <<'EOF'
SownteeShell command-line interface

Usage:
  sownteeshell ipc call <core|calendar> <method> [params-json]
  sownteeshell ipc methods [core|calendar]
  sownteeshell ipc help [core|calendar]
  sownteeshell --help [core|calendar]

Examples:
  sownteeshell ipc call core ping
  sownteeshell ipc call core system.info
  sownteeshell ipc call calendar accounts.list
  sownteeshell ipc methods core
EOF
}

print_legend() {
    cat <<'EOF'

Method flags:
  [read]     Does not intentionally change state
  [write]    Changes configuration, files, remote data, or runtime state
  [delete]   Removes data or terminates a process; use carefully
  [network]  Contacts an external service
  [stream]   Requires a persistent IPC connection; one-shot call is not useful

Most parameters use camelCase JSON fields. Wallpaper-provider fields are
snake_case and are shown exactly below. Required fields have no '?', optional
fields end in '?', and omitted params default to {}.
EOF
}


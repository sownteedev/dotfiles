print_calendar_methods() {
    cat <<'EOF'

Calendar methods (24):

  System
    ping                                  [read] Check IPC responsiveness
    system.info                           [read] PID, paths, providers and database counts

  Accounts
    accounts.list                         [read] List configured accounts
    accounts.google.add                   [write, network] clientId?, clientSecret?
    accounts.microsoft.add                [write, network] clientId?, tenant?
    accounts.icloud.add                   [write, network] email, username?, appPassword,
                                                           server?, displayName?
    accounts.remove                       [delete] accountId and its locally stored data
    accounts.setEnabled                   [write] accountId, enabled

  Calendars
    calendars.list                        [read] accountId?
    calendars.setVisible                  [write] calendarId, visible

  Events
    events.list                           [read] from?, to?, calendarId?, visibleOnly?
    events.create                         [write, network] calendarId, event
    events.update                         [write, network] eventId, event
    events.delete                         [delete, network] eventId
    events.parseIcs                       [read] filePath
    events.importIcs                      [write, network] calendarId, filePath

  Synchronization
    sync.now                              [write, network] accountId?; omit to sync all accounts
    subscribe                             [stream] topics? = accounts|calendars|events|
                                                   tasks|sync|system

  Google Tasks (shared with Todo)
    tasks.list                            [read] Cached tasks, lists, visibility and
                                                  per-account errors for every Google account
    tasks.setVisible                      [write] accountId, visible; Calendar filter only
    tasks.google.refresh                  [read, network] accountId
    tasks.google.create                   [write, network] accountId, listId, title, due?, notes?
    tasks.google.update                   [write, network] accountId, listId, taskId,
                                                  title?, due?, notes?, status?
    tasks.google.delete                   [delete, network] accountId, listId, taskId
    Due dates use YYYY-MM-DD; status is needsAction or completed.
    Google accounts and OAuth permissions are managed by Calendar, not Core.

  Event object
    Required: title, start, end
    Optional: description, location, allDay
    Time values use RFC 3339, for example 2026-09-07T09:00:00Z.

  Security note
    Account-add methods may place credentials in shell history. Prefer the
    Calendar UI for normal sign-in and use IPC authentication only for testing.
EOF
}

print_examples() {
    printf '\n%s\n' "Parameter examples:"
    case "${1:-all}" in
        all|core)
            cat <<'EOF'
  sownteeshell ipc call core stats.snapshot '{"mode":"ram"}'
  sownteeshell ipc call core process.memory '{"pid":1234}'
  sownteeshell ipc call core updates.check '{"force":true}'
EOF
            ;;
    esac
    case "${1:-all}" in
        all|calendar)
            cat <<'EOF'
  sownteeshell ipc call calendar calendars.list '{"accountId":"ACCOUNT_ID"}'
  sownteeshell ipc call calendar events.list \
    '{"from":"2026-09-07T00:00:00Z","to":"2026-09-08T00:00:00Z"}'
EOF
            ;;
    esac
    cat <<'EOF'

Environment:
  SOWNTEESHELL_BACKEND_DIR   Override ~/.local/lib/sownteeshell
  SOWNTEE_CORE_SOCKET        Override the Core Unix socket
  SOWNTEE_CALENDAR_SOCKET    Override the Calendar Unix socket

Exit status:
  0    Request completed successfully
  2    Invalid CLI syntax or target
  127  Selected backend binary is unavailable
  Other values are forwarded from the backend client.
EOF
}

print_methods() {
    case "${1:-all}" in
        all)
            print_core_methods
            print_calendar_methods
            ;;
        core)
            print_core_methods
            ;;
        calendar)
            print_calendar_methods
            ;;
        *)
            printf '%s\n' "unknown IPC target '$1'; expected core or calendar" >&2
            return 2
            ;;
    esac
}

print_full_help() {
    print_usage
    print_legend
    print_methods all
    print_examples all
}

case "${1:-}" in
    "")
        print_full_help
        exit 0
        ;;
    -h|--help|help)
        if [ "$#" -gt 2 ]; then
            print_usage >&2
            exit 2
        fi
        print_usage
        print_legend
        print_methods "${2:-all}"
        print_examples "${2:-all}"
        exit 0
        ;;
esac

if [ "$1" = "ipc" ]; then
    case "${2:-}" in
        methods|list|help|-h|--help)
            if [ "$#" -gt 3 ]; then
                print_usage >&2
                exit 2
            fi
            print_legend
            print_methods "${3:-all}"
            print_examples "${3:-all}"
            exit 0
            ;;
    esac
fi

if [ "$#" -lt 4 ] || [ "$1" != "ipc" ] || [ "$2" != "call" ]; then
    print_usage >&2
    exit 2
fi

case "$4" in
    -h|--help|help)
        print_legend
        print_methods "$3"
        print_examples "$3"
        exit 0
        ;;
esac

target=$3
method=$4
shift 4

if [ "$#" -gt 1 ]; then
    printf '%s\n' "params-json must be passed as one quoted argument" >&2
    exit 2
fi

backend_dir="${SOWNTEESHELL_BACKEND_DIR:-$HOME/.local/lib/sownteeshell}"
case "$target" in
    core)
        backend="$backend_dir/sownteeshell-core"
        ;;
    calendar)
        backend="$backend_dir/sownteeshell-calendar-daemon"
        ;;
    *)
        printf '%s\n' "unknown IPC target '$target'; expected core or calendar" >&2
        exit 2
        ;;
esac

if [ ! -x "$backend" ]; then
    printf '%s\n' "SownteeShell backend is not installed or executable: $backend" >&2
    exit 127
fi

if [ "$#" -eq 1 ]; then
    exec "$backend" request "$method" "$1"
fi

exec "$backend" request "$method"

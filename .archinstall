#!/bin/bash

set -e
set -u
set -o pipefail

partition_device() {
    local disk_device="$1"
    local partition_number="$2"

    if [[ "$disk_device" =~ [0-9]$ ]]; then
        printf '%sp%s\n' "$disk_device" "$partition_number"
    else
        printf '%s%s\n' "$disk_device" "$partition_number"
    fi
}

cpu_microcode_package() {
    local cpu_vendor="${1:-}"

    if [ -z "$cpu_vendor" ]; then
        cpu_vendor=$(awk -F ': *' '/^vendor_id/ { print $2; exit }' /proc/cpuinfo)
    fi
    case "$cpu_vendor" in
        GenuineIntel)
            printf '%s\n' "intel-ucode"
            ;;
        AuthenticAMD)
            printf '%s\n' "amd-ucode"
            ;;
        *)
            return 1
            ;;
    esac
}

echo ">>> Check Internet..."
ping -c 3 archlinux.org || {
    echo "Not Found Internet!"
    exit 1
}

echo ">>> Sync time and set keyboard..."
# Load keyboard layout
if loadkeys i386/qwerty/us.map.gz; then
    echo "Keyboard layout set successfully."
else
    echo "Failed to set keyboard layout. Please check the file path."
    exit 1
fi
# Synchronize time
if timedatectl set-ntp true; then
    echo "Time synchronization enabled."
else
    echo "Failed to enable time synchronization."
    exit 1
fi
# Set timezone
if timedatectl set-timezone Asia/Ho_Chi_Minh; then
    echo "Timezone set to Asia/Ho_Chi_Minh."
else
    echo "Failed to set timezone."
    exit 1
fi

# DISK
read -p "Enter the disk you want to partition (e.g., sda or nvme0n1): " disk
disk_device="/dev/$disk"

if [ ! -b "$disk_device" ]; then
    echo "Disk $disk_device not found. Exiting..."
    exit 1
fi
if [ "$(lsblk -ndo TYPE "$disk_device")" != "disk" ]; then
    echo "$disk_device is not a whole disk. Enter a device such as sda or nvme0n1."
    exit 1
fi

cfdisk "$disk_device" || {
    echo "Failed to partition disk."
    exit 1
}

echo ">>> Verify partition layout:"
lsblk "$disk_device"
read -p "All right? Press Enter to continue..."

partition_example=$(partition_device "$disk_device" 1)
read -p "Enter the partition number for swap (e.g., 1 for $partition_example): " swap_part
read -p "Enter the partition number for file system: " fs_part
read -p "Enter the partition number for boot: " boot_part

for partition_number in "$swap_part" "$fs_part" "$boot_part"; do
    if [[ ! "$partition_number" =~ ^[0-9]+$ ]]; then
        echo "Partition numbers must contain digits only."
        exit 1
    fi
done

if [ "$swap_part" = "$fs_part" ] || [ "$swap_part" = "$boot_part" ] || [ "$fs_part" = "$boot_part" ]; then
    echo "Swap, file system, and boot must use different partitions."
    exit 1
fi

swap_device=$(partition_device "$disk_device" "$swap_part")
fs_device=$(partition_device "$disk_device" "$fs_part")
boot_device=$(partition_device "$disk_device" "$boot_part")

udevadm settle
for partition in "$swap_device" "$fs_device" "$boot_device"; do
    if [ ! -b "$partition" ]; then
        echo "Partition $partition not found. Check the selected disk and partition number."
        exit 1
    fi
done

mkswap "$swap_device"
swapon "$swap_device"

mkfs.ext4 "$fs_device"
mount "$fs_device" /mnt

mkdir -p /mnt/boot
mount "$boot_device" /mnt/boot

lsblk "$disk_device"
read -p "All right? Press Enter to continue..."
clear

# Chroot
echo ">>> Basic install..."
base_packages=(base base-devel linux-zen linux-zen-headers linux-firmware sbctl)
if microcode_package=$(cpu_microcode_package); then
    base_packages+=("$microcode_package")
    echo ">>> Detected CPU microcode package: $microcode_package"
else
    echo ">>> CPU vendor is unknown; continuing without a microcode package."
fi
pacstrap /mnt "${base_packages[@]}"

echo ">>> Create fstab and go to chroot..."
genfstab -U /mnt >> /mnt/etc/fstab

# Type all information before go to chroot
read -p "Type hostname: " hostname
read -s -p "Type root password: " rootpassword
echo
read -p "Type username: " username
read -s -p "Type password for $username: " userpassword
echo

arch-chroot /mnt /bin/bash << EOF

# Time and languaue
ln -sf /usr/share/zoneinfo/Asia/Ho_Chi_Minh /etc/localtime
hwclock --systohc
echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen
echo LANG=en_US.UTF-8 > /etc/locale.conf

# Config hostname and hosts
echo "$hostname" > /etc/hostname
cat << EOL > /etc/hosts
127.0.0.1	localhost
::1			localhost
127.0.1.1	$hostname.localdomain	$hostname
EOL

# Root password
echo "root:$rootpassword" | chpasswd

# User and password
useradd -m -G wheel,audio,video,optical,storage,power $username
echo "$username:$userpassword" | chpasswd

echo ">>> Config sudo..."
sed -i 's/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers

echo ">>> Installing NetworkManager..."
pacman -S --noconfirm networkmanager wpa_supplicant wireless_tools
systemctl enable NetworkManager
systemctl enable systemd-timesyncd.service

echo ">>> Installing GRUB..."
pacman -S --noconfirm grub os-prober efibootmgr ntfs-3g mtools dosfstools
sed -i 's/^#GRUB_DISABLE_OS_PROBER=false/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --modules="tpm" --disable-shim-lock
grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB \
    --modules="tpm" --disable-shim-lock --removable --no-nvram
grub-mkconfig -o /boot/grub/grub.cfg

EOF

echo ">>> SUCCES. REBOOTING!"
umount -R /mnt
reboot
